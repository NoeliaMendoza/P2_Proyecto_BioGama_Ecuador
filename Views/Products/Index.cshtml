@model IReadOnlyList<BioGamaEcuador.Models.Sales.PhysicalProduct>
@{
    ViewData["Title"] = "Productos";
    }

<p class="text-muted mb-3">Materiales didácticos, kits de campo y recuerdos pensados para acercarte a la biodiversidad del Ecuador.</p>
<div class="d-flex gap-2 mb-3">
    <span class="badge badge-soft-primary fs-6 px-3 py-2"><i class="bi bi-box me-1"></i>@ViewBag.TotalProducts productos</span>
    <span class="badge badge-soft-success fs-6 px-3 py-2"><i class="bi bi-check2-circle me-1"></i>@ViewBag.AvailableUnits unidades disponibles</span>
</div>
    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@successMsg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMsg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="app-card filter-card mb-4">
        <div class="app-card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-8">
                    <label class="form-label" for="search">Buscar productos</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="search" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Nombre, tipo de material o temática…" />
                    </div>
                </div>
                <div class="col-6 col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Buscar</button></div>
                <div class="col-6 col-md-2"><a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a></div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="app-card"><div class="empty-state"><i class="bi bi-box2-heart"></i><h5>No encontramos productos</h5><p class="mb-3">Prueba con otra búsqueda o revisa todo el catálogo.</p><a asp-action="Index" class="btn btn-primary btn-sm">Ver todos los productos</a></div></div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                var available = p.Stock - p.ReservedStock;
                var lowStock = available > 0 && available <= p.MinStock;
                <article class="product-card @(available == 0 ? "product-card--sold-out" : "")">
                    <div class="product-card-image">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="product-card-placeholder"><i class="bi bi-box-seam"></i><span>BioGama Ecuador</span></div>
                        }
                        <div class="product-card-status">
                            @if (available <= 0) { <span class="badge badge-soft-danger">Agotado</span> }
                            else if (lowStock) { <span class="badge badge-soft-warning">Últimas @available unidades</span> }
                            else { <span class="badge badge-soft-success">Disponible</span> }
                        </div>
                    </div>
                    <div class="product-card-body">
                        <div class="product-card-sku"><i class="bi bi-upc-scan me-1"></i>@p.SKU</div>
                        <h2 class="product-card-title">@p.Name</h2>
                        <p class="product-card-desc">@p.Description</p>
                        <div class="product-card-footer">
                            <div><span class="product-card-price">$@p.Price.ToString("N2", new System.Globalization.CultureInfo("es-EC"))</span><small>USD</small></div>
                            <span class="product-card-stock"><i class="bi bi-box2 me-1"></i>@available disponibles</span>
                        </div>
                        @if (available > 0)
                        {
                            <form asp-controller="Orders" asp-action="CreateFromProduct" method="post" class="product-card-buy">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                <label class="visually-hidden" for="qty-@p.Id">Cantidad</label>
                                <input id="qty-@p.Id" type="number" name="quantity" value="1" min="1" max="@available" class="form-control form-control-sm" />
                                <button class="btn btn-primary btn-sm"><i class="bi bi-cart-plus me-1"></i>Agregar</button>
                            </form>
                        }
                        else { <button class="btn btn-outline-secondary btn-sm w-100" disabled>Producto agotado</button> }
                    </div>
                </article>
            }
        </div>

        @if ((int)ViewBag.TotalPages > 1)
        {
            <nav class="app-pagination" aria-label="Paginación de productos"><ul class="pagination justify-content-center flex-wrap">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++) { <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a></li> }
            </ul><p class="app-pagination-info">Página @ViewBag.Page de @ViewBag.TotalPages</p></nav>
        }
    }

