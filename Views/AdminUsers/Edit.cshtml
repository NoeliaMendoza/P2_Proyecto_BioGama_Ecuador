@model BioGamaEcuador.Models.Admin.UserEditViewModel
@{ViewData["Title"]="Editar roles";Layout="_LayoutAdmin";}
<div class="app-card form-card"><div class="app-card-header"><h5>Roles de @Model.Email</h5></div><div class="app-card-body"><form method="post" asp-action="Edit" asp-route-id="@Model.UserId"><input type="hidden" asp-for="UserId"/><input type="hidden" asp-for="Email"/><div class="mb-3">@for(int i=0;i<Model.Roles.Count;i++){<div class="form-check mb-2"><input type="hidden" asp-for="Roles[i].RoleName"/><input asp-for="Roles[i].IsAssigned" class="form-check-input"/><label class="form-check-label" asp-for="Roles[i].IsAssigned">@Model.Roles[i].RoleName</label></div>}</div><button class="btn btn-primary">Guardar cambios</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>
