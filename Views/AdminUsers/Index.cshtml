@model IReadOnlyList<BioGamaEcuador.Models.Admin.UserListViewModel>
@{ViewData["Title"]="Usuarios";Layout="_LayoutAdmin";}
<div class="page-header"><div><h1 class="page-header-title">Usuarios</h1><p class="page-header-subtitle">Gestion de roles de usuarios registrados.</p></div></div><div class="app-card table-card"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Correo</th><th>Confirmado</th><th>Roles</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="4" class="text-center py-4">No hay usuarios.</td></tr>}@foreach(var u in Model){<tr><td class="fw-semibold">@u.Email</td><td><span class="badge @(u.EmailConfirmed?"text-bg-success":"text-bg-warning")">@(u.EmailConfirmed?"Si":"No")</span></td><td>@foreach(var r in u.Roles){<span class="badge text-bg-info me-1">@r</span>}</td><td><a class="btn-action edit" asp-action="Edit" asp-route-id="@u.UserId"><i class="bi bi-pencil"></i></a></td></tr>}</tbody></table></div></div>
