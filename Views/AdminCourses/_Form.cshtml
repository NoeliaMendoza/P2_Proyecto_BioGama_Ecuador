@model BioGamaEcuador.Models.Admin.CourseFormViewModel
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden"/><div class="form-section"><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Price" class="form-label">Precio</label><input asp-for="Price" class="form-control"/><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label">Descripción</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="Syllabus" class="form-label">Temario (Markdown)</label><textarea asp-for="Syllabus" class="form-control" rows="4"></textarea></div><div class="col-md-3"><label asp-for="TotalSeats" class="form-label">Cupos</label><input asp-for="TotalSeats" class="form-control"/></div><div class="col-md-3"><label asp-for="Modality" class="form-label">Modalidad</label><select asp-for="Modality" class="form-select"><option>Presencial</option><option>Virtual</option><option>Hibrido</option></select></div><div class="col-md-3"><label asp-for="StartDate" class="form-label">Inicio</label><input asp-for="StartDate" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="EndDate" class="form-label">Fin</label><input asp-for="EndDate" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="StartTime" class="form-label">Hora inicio</label><input asp-for="StartTime" type="time" class="form-control"/></div><div class="col-md-3"><label asp-for="EndTime" class="form-label">Hora fin</label><input asp-for="EndTime" type="time" class="form-control"/></div><div class="col-md-6"><label asp-for="Venue" class="form-label">Lugar / enlace</label><input asp-for="Venue" class="form-control"/></div><div class="col-md-6"><label asp-for="Instructor" class="form-label">Instructor</label><input asp-for="Instructor" class="form-control"/></div><div class="col-12"><label asp-for="InstructorBio" class="form-label">Bio del instructor</label><textarea asp-for="InstructorBio" class="form-control"></textarea></div><div class="col-md-6"><label asp-for="SpeciesId" class="form-label">Especie relacionada</label><select asp-for="SpeciesId" asp-items="ViewBag.SpeciesId" class="form-select"><option value="">Ninguna</option></select></div><div class="col-md-6"><label asp-for="ImageUrl" class="form-label">URL imagen</label><input asp-for="ImageUrl" class="form-control"/></div><div class="col-12 d-flex gap-4"><div class="form-check"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Activo</label></div><div class="form-check"><input asp-for="RequiresPriorKnowledge" class="form-check-input"/><label asp-for="RequiresPriorKnowledge" class="form-check-label">Requiere conocimientos previos</label></div></div><div class="col-12"><label asp-for="TargetAudience" class="form-label">Público objetivo</label><input asp-for="TargetAudience" class="form-control"/></div></div></div><div class="form-actions"><button class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form>
