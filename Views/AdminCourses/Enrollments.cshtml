@model IReadOnlyList<BioGamaEcuador.Models.Sales.Enrollment>
@{ViewData["Title"]="Inscritos";Layout="_LayoutAdmin";var course=(BioGamaEcuador.Models.Sales.Course)ViewBag.Course;}
<div class="page-header"><div><h1 class="page-header-title">Inscritos: @course.Title</h1><p class="page-header-subtitle">@Model.Count registro(s)</p></div><a asp-action="Index" class="btn btn-outline-secondary">Volver</a></div><div class="app-card table-card"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Participante</th><th>Correo</th><th>Código</th><th>Estado</th><th>Inscripción</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="text-center py-4">No hay inscritos.</td></tr>}@foreach(var e in Model){<tr><td>@e.User?.UserName</td><td>@e.User?.Email</td><td>@e.ConfirmationCode</td><td>@e.Status</td><td>@e.EnrolledAt.ToString("dd/MM/yyyy")</td><td>@if(e.Status!="Attended"&&e.Status!="Cancelled"){<form method="post" asp-action="CheckIn" asp-route-courseId="@course.Id" asp-route-id="@e.Id"><button class="btn btn-sm btn-success"><i class="bi bi-check2"></i> Asistencia</button></form>}else if(e.Status=="Attended"){<span class="text-success">Asistió</span>}</td></tr>}</tbody></table></div></div>
