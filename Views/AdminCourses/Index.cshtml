@model IReadOnlyList<BioGamaEcuador.Models.Sales.Course>
@{ViewData["Title"]="Cursos";Layout="_LayoutAdmin";}
<div class="page-header"><div><h1 class="page-header-title">Cursos</h1></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo curso</a></div>
<div class="app-card filter-card mb-3"><div class="app-card-body"><form class="row g-2" method="get"><div class="col-md-4"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Buscar título"/></div><div class="col-md-2"><select class="form-select" name="modality"><option value="">Modalidad</option>@foreach(var x in new[]{"Presencial","Virtual","Hibrido"}){<option selected="@(ViewBag.Modality==x)">@x</option>}</select></div><div class="col-md-2"><select class="form-select" name="status"><option value="">Estado</option><option value="active">Activo</option><option value="inactive">Inactivo</option><option value="finished">Finalizado</option></select></div><div class="col-md-2"><input type="date" class="form-control" name="date" value="@ViewBag.Date"/></div><div class="col-md-2"><button class="btn btn-primary">Filtrar</button> <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a></div></form></div></div>
<div class="app-card table-card"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Título</th><th>Modalidad</th><th>Cupos</th><th>Precio</th><th>Fechas</th><th>Estado</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="text-center py-4">No se encontraron cursos.</td></tr>}@foreach(var c in Model){<tr><td class="fw-semibold">@c.Title</td><td>@c.Modality</td><td>@(c.TotalSeats-c.ReservedSeats-c.ConfirmedSeats)/@c.TotalSeats</td><td>@c.Price.ToString("C")</td><td>@c.StartDate.ToString("dd/MM/yy") - @c.EndDate.ToString("dd/MM/yy")</td><td><span class="badge @(c.IsActive?"text-bg-success":"text-bg-secondary")">@(c.IsActive?"Activo":"Inactivo")</span></td><td><a class="btn-action view" asp-action="Enrollments" asp-route-courseId="@c.Id" title="Ver inscritos"><i class="bi bi-people"></i></a> <a class="btn-action edit" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a> <a class="btn-action delete" asp-action="DeleteConfirmation" asp-route-id="@c.Id" title="Eliminar"><i class="bi bi-trash"></i></a></td></tr>}</tbody></table></div></div>
