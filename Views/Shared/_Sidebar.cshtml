@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject BioGamaEcuador.Data.AppDbContext DbContext

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    bool IsActive(string ctrl, string? act = null) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) &&
        (act == null || string.Equals(action, act, StringComparison.OrdinalIgnoreCase));

    bool IsHomeActive = IsActive("Home", "Index");
    bool isAuthenticated = SignInManager.IsSignedIn(User);

    var userId = UserManager.GetUserId(User);
    var cartCount = 0;
    if (userId != null)
    {
        cartCount = await DbContext.Database.SqlQueryRaw<int>(
            "SELECT COALESCE(SUM(od.\"Quantity\"), 0) AS \"Value\" FROM \"OrderDetails\" od INNER JOIN \"Orders\" o ON o.\"Id\" = od.\"OrderId\" WHERE o.\"UserId\" = {0} AND o.\"Status\" = 'Pending'",
            userId
        ).FirstOrDefaultAsync();
    }
}

<aside class="app-sidebar" id="appSidebar">
    <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
        <div class="sidebar-brand-icon">
            <i class="bi bi-flower1"></i>
        </div>
        <div class="sidebar-brand-text">
            BioGama
            <span class="sidebar-brand-sub">Ecuador</span>
        </div>
    </a>

    <nav class="sidebar-nav">
        <div class="sidebar-section-title">Principal</div>
        <a class="sidebar-link @(IsHomeActive ? "active" : "")" asp-controller="Home" asp-action="Index">
            <i class="bi bi-grid-1x2"></i>
            <span class="sidebar-label">Panel</span>
        </a>

        <div class="sidebar-section-title">Explorar</div>
        <a class="sidebar-link @(IsActive("Public") ? "active" : "")" asp-controller="Public" asp-action="Catalogo">
            <i class="bi bi-book"></i>
            <span class="sidebar-label">Explorar Especies</span>
        </a>
        <a class="sidebar-link @(IsActive("Courses") ? "active" : "")" asp-controller="Courses" asp-action="Index">
            <i class="bi bi-mortarboard"></i>
            <span class="sidebar-label">Cursos</span>
        </a>
        <a class="sidebar-link @(IsActive("Products") ? "active" : "")" asp-controller="Products" asp-action="Index">
            <i class="bi bi-box-seam"></i>
            <span class="sidebar-label">Productos</span>
        </a>
        <a class="sidebar-link @(IsActive("Ia") ? "active" : "")" asp-controller="Ia" asp-action="Index">
            <i class="bi bi-cpu"></i>
            <span class="sidebar-label">Asistente IA</span>
        </a>

        @if (isAuthenticated)
        {
            <div class="sidebar-section-title">Tienda</div>
            <a class="sidebar-link @(IsActive("Orders", "Cart") ? "active" : "")" asp-controller="Orders" asp-action="Cart">
                <i class="bi bi-cart"></i>
                <span class="sidebar-label">Mi Carrito</span>
                @if (cartCount > 0)
                {
                    <span class="badge bg-primary rounded-pill ms-auto">@cartCount</span>
                }
            </a>
            <a class="sidebar-link @(IsActive("MyCourses") ? "active" : "")" asp-controller="MyCourses" asp-action="Index">
                <i class="bi bi-book"></i>
                <span class="sidebar-label">Mis Cursos</span>
            </a>
            <a class="sidebar-link @(IsActive("Orders", "MyOrders") ? "active" : "")" asp-controller="Orders" asp-action="MyOrders">
                <i class="bi bi-receipt"></i>
                <span class="sidebar-label">Mis Compras</span>
            </a>

            @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
            {
                <div class="sidebar-section-title">Gestión</div>
                <a class="sidebar-link @(IsActive("Species") ? "active" : "")" asp-controller="Species" asp-action="Index">
                    <i class="bi bi-bug"></i>
                    <span class="sidebar-label">Especies</span>
                </a>
                <a class="sidebar-link @(IsActive("Families") ? "active" : "")" asp-controller="Families" asp-action="Index">
                    <i class="bi bi-diagram-3"></i>
                    <span class="sidebar-label">Familias</span>
                </a>
                <a class="sidebar-link @(IsActive("Researchers") ? "active" : "")" asp-controller="Researchers" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    <span class="sidebar-label">Investigadores</span>
                </a>
                <a class="sidebar-link @(IsActive("NaturalReserves") ? "active" : "")" asp-controller="NaturalReserves" asp-action="Index">
                    <i class="bi bi-tree"></i>
                    <span class="sidebar-label">Reservas</span>
                </a>
                <a class="sidebar-link @(IsActive("Locations") ? "active" : "")" asp-controller="Locations" asp-action="Index">
                    <i class="bi bi-geo-alt"></i>
                    <span class="sidebar-label">Ubicaciones</span>
                </a>
                <a class="sidebar-link @(IsActive("Records") ? "active" : "")" asp-controller="Records" asp-action="Index">
                    <i class="bi bi-journal-text"></i>
                    <span class="sidebar-label">Registros</span>
                </a>

                <div class="sidebar-section-title">Analítica</div>
                <a class="sidebar-link @(IsActive("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i>
                    <span class="sidebar-label">Reportes</span>
                </a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Administrador"))
            {
                <div class="sidebar-section-title">Administración</div>
                <a class="sidebar-link @(IsActive("Admin") ? "active" : "")" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-check"></i>
                    <span class="sidebar-label">Panel admin</span>
                </a>
                <a class="sidebar-link @(IsActive("AdminUsers") ? "active" : "")" asp-controller="AdminUsers" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span class="sidebar-label">Usuarios</span>
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer d-none d-lg-block">
        <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" aria-label="Colapsar menú">
            <i class="bi bi-layout-sidebar-inset"></i>
        </button>
    </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
