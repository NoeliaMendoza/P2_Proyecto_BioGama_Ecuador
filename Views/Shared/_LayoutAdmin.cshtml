<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - Administración BioGama</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/BioGamaEcuador.styles.css" asp-append-version="true" />@await RenderSectionAsync("Styles", false)</head>
<body><div class="app-shell" id="appShell"><aside class="app-sidebar"><a class="sidebar-brand" asp-controller="Admin" asp-action="Index"><div class="sidebar-brand-icon"><i class="bi bi-shield-check"></i></div><div class="sidebar-brand-text">BioGama<span class="sidebar-brand-sub">Administración</span></div></a><nav class="sidebar-nav"><div class="sidebar-section-title">Administración</div><a class="sidebar-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-1x2"></i><span class="sidebar-label">Dashboard</span></a><a class="sidebar-link" asp-controller="AdminCourses" asp-action="Index"><i class="bi bi-mortarboard"></i><span class="sidebar-label">Cursos</span></a><a class="sidebar-link" asp-controller="AdminProducts" asp-action="Index"><i class="bi bi-box-seam"></i><span class="sidebar-label">Productos físicos</span></a><a class="sidebar-link" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i><span class="sidebar-label">Control de cupos</span></a></nav></aside><div class="app-main"><partial name="_Topbar"/><main class="app-content"><div class="app-content-inner"><partial name="_Breadcrumb"/>@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}@RenderBody()</div></main></div></div><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", false)</body></html>
