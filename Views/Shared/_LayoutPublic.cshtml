@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string ctrl) => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase);
    bool isSignedIn = SignInManager.IsSignedIn(User);
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BioGama Ecuador</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BioGamaEcuador.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-catalogo.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="public-body">
    <header class="public-header">
        <nav class="public-navbar">
            <div class="public-navbar-inner">
                <a class="public-brand" asp-controller="Public" asp-action="Catalogo">
                    <span class="public-brand-icon"><i class="bi bi-flower1"></i></span>
                    <span class="public-brand-text">
                        BioGama
                        <small>Ecuador</small>
                    </span>
                </a>

                <button class="public-nav-toggle d-lg-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navPublic" aria-expanded="false" aria-label="Menú">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse public-nav-collapse" id="navPublic">
                    <ul class="public-nav-links">
                        <li>
                            <a class="public-nav-link @(IsActive("Public") ? "active" : "")"
                               asp-controller="Public" asp-action="Catalogo">
                                <i class="bi bi-book"></i> Explorar Especies
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link @(IsActive("Courses") ? "active" : "")"
                               asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-mortarboard"></i> Cursos
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link @(IsActive("Products") ? "active" : "")"
                               asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Productos
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link @(IsActive("Donations") ? "active" : "")"
                               asp-controller="Donations" asp-action="Index">
                                <i class="bi bi-heart"></i> Adopta
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link @(IsActive("Ia") ? "active" : "")"
                               asp-controller="Ia" asp-action="Index">
                                <i class="bi bi-cpu"></i> Asistente IA
                            </a>
                        </li>
                    </ul>

                    <div class="public-nav-actions">
                        @if (isSignedIn)
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2 me-1"></i> Panel
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-area="Identity" asp-page="/Account/Login">
                                Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="public-main" role="main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div class="public-footer-brand">
                <i class="bi bi-flower1"></i>
                <span>BioGama Ecuador</span>
            </div>
            <p class="public-footer-copy">
                &copy; 2026 BioGama Ecuador &mdash; Sistema de Biodiversidad del Ecuador
            </p>
            <span class="public-footer-badge">Datos abiertos al público</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
