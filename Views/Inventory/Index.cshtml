@model IReadOnlyList<BioGamaEcuador.Models.Sales.InventoryMovement>
@{ViewData["Title"]="Control de inventario";Layout="_LayoutAdmin";}
<div class="page-header"><div><h1 class="page-header-title">Control de inventario</h1><p class="page-header-subtitle">Movimientos y ajustes de productos físicos y cursos.</p></div></div>
<div class="row g-3 mb-3"><div class="col-lg-4"><div class="app-card"><div class="app-card-header"><h6>Registrar entrada</h6></div><div class="app-card-body"><form asp-action="Entry" method="post"><partial name="_TransactionForm" model="new BioGamaEcuador.Models.Admin.InventoryTransactionViewModel()"/><button class="btn btn-success">Registrar entrada</button></form></div></div></div><div class="col-lg-4"><div class="app-card"><div class="app-card-header"><h6>Registrar salida</h6></div><div class="app-card-body"><form asp-action="Exit" method="post"><partial name="_TransactionForm" model="new BioGamaEcuador.Models.Admin.InventoryTransactionViewModel()"/><button class="btn btn-warning">Registrar salida</button></form></div></div></div><div class="col-lg-4"><div class="app-card"><div class="app-card-header"><h6>Ajustar stock</h6></div><div class="app-card-body"><form asp-action="Adjustment" method="post"><partial name="_TransactionForm" model="new BioGamaEcuador.Models.Admin.InventoryAdjustmentViewModel()"/><div class="mb-2"><label class="form-label">Nuevo stock total</label><input name="NewStock" type="number" min="0" class="form-control" required/></div><button class="btn btn-primary">Ajustar</button></form></div></div></div></div>
<div class="app-card filter-card mb-3"><div class="app-card-body"><form method="get" class="row g-2"><div class="col-md-3"><select name="type" asp-items="ViewBag.Types" class="form-select"><option value="">Todos los tipos</option></select></div><div class="col-md-3"><select name="productId" asp-items="ViewBag.Products" class="form-select"><option value="">Todos los productos</option></select></div><div class="col-md-2"><input name="from" value="@ViewBag.From" type="date" class="form-control"/></div><div class="col-md-2"><input name="to" value="@ViewBag.To" type="date" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary">Filtrar</button></div></form></div></div>
<div class="app-card table-card"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Producto / curso</th><th>Cantidad</th><th>Stock</th><th>Referencia</th><th>Notas</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="text-center py-4">No hay movimientos.</td></tr>}@foreach(var m in Model){<tr><td>@m.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@m.TipoMovimiento</td><td>@(m.PhysicalProduct?.Name ?? m.Course?.Title)</td><td>@m.Cantidad</td><td>@m.StockAnterior -> @m.StockPosterior</td><td>@m.Referencia</td><td>@m.Observacion</td></tr>}</tbody></table></div></div>