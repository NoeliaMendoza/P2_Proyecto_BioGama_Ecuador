@model IEnumerable<BioGamaEcuador.Models.Sales.Course>

@{
    ViewData["Title"] = "Catálogo de Cursos y Talleres";
    }

<p class="text-muted mb-3">
    Aprende de expertos en biodiversidad. Cursos presenciales, virtuales e híbridos
    con cupos limitados. Reserva tu lugar con anticipación.
</p>
<div class="d-flex gap-2 mb-3">
    <span class="badge badge-soft-primary fs-6 px-3 py-2">
        <i class="bi bi-calendar-event me-1"></i>@ViewBag.ProximosCursos cursos próximos
    </span>
    <span class="badge badge-soft-success fs-6 px-3 py-2">
        <i class="bi bi-people me-1"></i>@ViewBag.TotalCupos cupos disponibles
    </span>
</div>
    <div class="app-card filter-card mb-4">
        <div class="app-card-body">
            <form method="get" asp-controller="Courses" asp-action="Index">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="busqueda" class="form-control border-start-0 ps-0"
                                   placeholder="Título, instructor, temática…" value="@ViewBag.Busqueda" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Modalidad</label>
                        <select name="modalidad" class="form-select">
                            <option value="">Todas</option>
                            <option value="Presencial" selected="@(ViewBag.ModalidadFiltro == "Presencial")">Presencial</option>
                            <option value="Virtual" selected="@(ViewBag.ModalidadFiltro == "Virtual")">Virtual</option>
                            <option value="Hibrido" selected="@(ViewBag.ModalidadFiltro == "Hibrido")">Híbrido</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="abierto" selected="@(ViewBag.EstadoFiltro == "abierto")">Abierto (cupos)</option>
                            <option value="agotado" selected="@(ViewBag.EstadoFiltro == "agotado")">Agotado</option>
                            <option value="finalizado" selected="@(ViewBag.EstadoFiltro == "finalizado")">Finalizado</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="app-card">
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h5>No hay cursos disponibles</h5>
                <p class="mb-3">No se encontraron cursos con los filtros seleccionados.</p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-sm">
                    Ver todos los cursos
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="course-grid">
            @foreach (var c in Model)
            {
                var disponible = c.AvailableSeats > 0 && c.IsActive && c.StartDate > DateTime.UtcNow;
                var agotado = c.AvailableSeats == 0 || c.StartDate <= DateTime.UtcNow;

                <article class="course-card @(agotado ? "course-card--sold-out" : "")">
                    <div class="course-card-image">
                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                        {
                            <img src="@c.ImageUrl" alt="@c.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="course-card-image-placeholder">
                                <i class="bi bi-mortarboard"></i>
                                <span>@c.Modality</span>
                            </div>
                        }
                        <div class="course-card-status">
                            @if (agotado)
                            {
                                <span class="badge badge-soft-danger">Agotado</span>
                            }
                            else if (!disponible)
                            {
                                <span class="badge badge-soft-secondary">Finalizado</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-success">@c.AvailableSeats cupos</span>
                            }
                        </div>
                    </div>

                    <div class="course-card-body">
                        <div class="course-card-badges mb-2">
                            <span class="badge badge-soft-primary">@c.Modality</span>
                            @if (c.Species != null)
                            {
                                <span class="badge badge-soft-secondary">@c.Species.CommonName</span>
                            }
                        </div>

                        <h3 class="course-card-title">@c.Title</h3>
                        <p class="course-card-instructor">
                            <i class="bi bi-person-badge me-1"></i>@c.Instructor
                        </p>

                        <p class="course-card-desc">
                            @c.Description
                        </p>

                        <div class="course-card-meta mb-3">
                            <div class="course-meta-row">
                                <i class="bi bi-calendar3"></i>
                                <span>@c.StartDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-EC")) @if (c.EndDate != c.StartDate) { <span> – </span> @c.EndDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-EC")) }</span>
                            </div>
                            <div class="course-meta-row">
                                <i class="bi bi-clock"></i>
                                <span>@c.StartTime.ToString(@"hh\:mm") – @c.EndTime.ToString(@"hh\:mm")</span>
                            </div>
                            <div class="course-meta-row">
                                <i class="bi bi-geo-alt"></i>
                                <span>@c.Venue</span>
                            </div>
                            <div class="course-meta-row">
                                <i class="bi bi-people"></i>
                                <span>@c.AvailableSeats / @c.TotalSeats cupos</span>
                            </div>
                        </div>

                        <div class="course-card-footer">
                            <span class="course-card-price">$@c.Price.ToString("N2", new System.Globalization.CultureInfo("es-EC")) USD</span>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id"
                               class="btn btn-primary btn-sm @(c.AvailableSeats > 0 && c.IsActive && c.StartDate > DateTime.UtcNow ? "" : "disabled")">
                                <i class="bi bi-eye me-1"></i>Ver detalle
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        int paginaActual = (int)ViewBag.PaginaActual;
        int totalPaginas = (int)ViewBag.TotalPaginas;
        int rango = 9;
        int inicio = Math.Max(1, paginaActual - rango);
        int fin = Math.Min(totalPaginas, paginaActual + rango);
        if (totalPaginas > 1)
        {
            <nav class="app-pagination" aria-label="Paginación cursos">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="Courses" asp-action="Index" asp-route-pagina="1"
                           asp-route-busqueda="@ViewBag.Busqueda" asp-route-modalidad="@ViewBag.ModalidadFiltro"
                           asp-route-estado="@ViewBag.EstadoFiltro">&laquo;</a>
                    </li>
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="Courses" asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)" asp-route-busqueda="@ViewBag.Busqueda"
                           asp-route-modalidad="@ViewBag.ModalidadFiltro" asp-route-estado="@ViewBag.EstadoFiltro">&lsaquo;</a>
                    </li>
                    @if (inicio > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    @for (int i = inicio; i <= fin; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" asp-controller="Courses" asp-action="Index" asp-route-pagina="@i"
                               asp-route-busqueda="@ViewBag.Busqueda" asp-route-modalidad="@ViewBag.ModalidadFiltro"
                               asp-route-estado="@ViewBag.EstadoFiltro">@i</a>
                        </li>
                    }
                    @if (fin < totalPaginas)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-controller="Courses" asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)" asp-route-busqueda="@ViewBag.Busqueda"
                           asp-route-modalidad="@ViewBag.ModalidadFiltro" asp-route-estado="@ViewBag.EstadoFiltro">&rsaquo;</a>
                    </li>
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-controller="Courses" asp-action="Index" asp-route-pagina="@totalPaginas"
                           asp-route-busqueda="@ViewBag.Busqueda" asp-route-modalidad="@ViewBag.ModalidadFiltro"
                           asp-route-estado="@ViewBag.EstadoFiltro">&raquo;</a>
                    </li>
                </ul>
                <p class="app-pagination-info">Página @paginaActual de @totalPaginas</p>
            </nav>
        }
    }

