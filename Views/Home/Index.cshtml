@using Microsoft.EntityFrameworkCore
@inject BioGamaEcuador.Data.AppDbContext Db

@{
    ViewData["Title"] = "Dashboard";
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Administrador");
    var isInvestigador = User.IsInRole("Investigador");
    var isPublicUser = isAuth && !isAdmin && !isInvestigador;

    int totalEspecies = 0, totalFlora = 0, totalFauna = 0, totalHongos = 0;
    int totalInvestigadores = 0, totalReservas = 0, totalRegistros = 0;
    int totalFamilias = 0, totalUbicaciones = 0;
    var registrosRecientes = new List<BioGamaEcuador.Models.Record>();
    var registrosPorRegion = new List<dynamic>();
    var especiesPorEstado = new List<dynamic>();
    bool tienePerfilInvestigador = false;

    totalEspecies = await Db.Species.CountAsync(s => s.IsActive);
    totalRegistros = await Db.Records.CountAsync(r => r.IsActive);
    totalReservas = await Db.NaturalReserves.CountAsync(r => r.IsActive);
    totalFamilias = await Db.Families.CountAsync(f => f.IsActive);

    if (isAuth)
    {
        totalInvestigadores = await Db.Researchers.CountAsync(r => r.IsActive);
        totalUbicaciones = await Db.Locations.CountAsync(l => l.IsActive);

        totalFlora = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && (EF.Functions.ILike(s.Family.Kingdom, "%vegetal%") || EF.Functions.ILike(s.Family.Kingdom, "%plantae%")));
        totalFauna = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && (EF.Functions.ILike(s.Family.Kingdom, "%animal%") || EF.Functions.ILike(s.Family.Kingdom, "%animalia%")));
        totalHongos = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && (EF.Functions.ILike(s.Family.Kingdom, "%fungi%") || EF.Functions.ILike(s.Family.Kingdom, "%hongo%")));

        var userEmailCtx = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name;
        tienePerfilInvestigador = isInvestigador && !string.IsNullOrEmpty(userEmailCtx)
            && await Db.Researchers.AnyAsync(r => r.Email == userEmailCtx);

        registrosRecientes = await Db.Records
            .AsNoTracking()
            .Where(r => r.IsActive)
            .Include(r => r.Species)
            .Include(r => r.Researcher)
            .Include(r => r.Location)
            .OrderByDescending(r => r.DiscoveryDate)
            .Take(8)
            .ToListAsync();

        registrosPorRegion = (await Db.Records
            .AsNoTracking()
            .Where(r => r.IsActive && r.Location != null && r.Location.NaturalReserve != null)
            .Include(r => r.Location)
                .ThenInclude(l => l.NaturalReserve)
            .GroupBy(r => r.Location!.NaturalReserve!.Region)
            .Select(g => new { Region = g.Key, Total = g.Count() })
            .OrderByDescending(x => x.Total)
            .Take(6)
            .ToListAsync()).Cast<dynamic>().ToList();

        especiesPorEstado = (await Db.Species
            .AsNoTracking()
            .Where(s => s.IsActive && s.ConservationStatus != null)
            .GroupBy(s => new { s.ConservationStatus!.Code, s.ConservationStatus.Name })
            .Select(g => new { g.Key.Code, g.Key.Name, Total = g.Count() })
            .OrderByDescending(x => x.Total)
            .Take(8)
            .ToListAsync()).Cast<dynamic>().ToList();
    }
}

