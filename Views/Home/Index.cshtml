@using Microsoft.EntityFrameworkCore
@inject BioGamaEcuador.Data.AppDbContext Db

@{
    ViewData["Title"] = "Dashboard";
    var isAuth = User.Identity?.IsAuthenticated == true;

    int totalEspecies = 0, totalFlora = 0, totalFauna = 0, totalHongos = 0;
    int totalInvestigadores = 0, totalReservas = 0, totalRegistros = 0;
    var registrosRecientes = new List<BioGamaEcuador.Models.Record>();
    var registrosPorRegion = new List<dynamic>();
    var especiesPorEstado = new List<dynamic>();

    if (isAuth)
    {
        totalEspecies = await Db.Species.CountAsync(s => s.IsActive);
        totalRegistros = await Db.Records.CountAsync(r => r.IsActive);
        totalInvestigadores = await Db.Researchers.CountAsync(r => r.IsActive);
        totalReservas = await Db.NaturalReserves.CountAsync(r => r.IsActive);

        totalFlora = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && s.Family.Kingdom == "Vegetal");
        totalFauna = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && s.Family.Kingdom == "Animal");
        totalHongos = await Db.Species.CountAsync(s => s.IsActive && s.Family != null && s.Family.Kingdom == "Fungi");

        registrosRecientes = await Db.Records
            .AsNoTracking()
            .Where(r => r.IsActive)
            .Include(r => r.Species)
            .Include(r => r.Researcher)
            .Include(r => r.Location)
            .OrderByDescending(r => r.DiscoveryDate)
            .Take(8)
            .ToListAsync();

        registrosPorRegion = (await Db.Records
            .AsNoTracking()
            .Where(r => r.IsActive)
            .Include(r => r.Location!)
                .ThenInclude(l => l.NaturalReserve)
            .GroupBy(r => r.Location!.NaturalReserve!.Region)
            .Select(g => new { Region = g.Key, Total = g.Count() })
            .OrderByDescending(x => x.Total)
            .Take(6)
            .ToListAsync()).Cast<dynamic>().ToList();

        especiesPorEstado = (await Db.Species
            .AsNoTracking()
            .Where(s => s.IsActive && s.ConservationStatus != null)
            .GroupBy(s => new { s.ConservationStatus!.Code, s.ConservationStatus.Name })
            .Select(g => new { g.Key.Code, g.Key.Name, Total = g.Count() })
            .OrderByDescending(x => x.Total)
            .Take(8)
            .ToListAsync()).Cast<dynamic>().ToList();
    }
}

@if (!isAuth)
{
    <div class="welcome-hero">
        <div class="stat-card-icon primary mx-auto mb-3" style="width:56px;height:56px;font-size:1.5rem;">
            <i class="bi bi-flower1"></i>
        </div>
        <h1>BioGama Ecuador</h1>
        <p>Centraliza el conocimiento sobre la biodiversidad del Ecuador. Flora, fauna y hongos en un solo lugar.</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Public" asp-action="Catalogo" class="btn btn-primary btn-lg">
                <i class="bi bi-book me-2"></i>Ver catálogo
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Acceder
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="app-card role-card h-100">
                <div class="app-card-body text-center">
                    <div class="stat-card-icon primary mx-auto"><i class="bi bi-shield-check"></i></div>
                    <h5 class="fw-semibold">Administrador</h5>
                    <p class="text-muted small mb-0">Gestiona catálogo, familias, reservas y ubicaciones.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="app-card role-card h-100">
                <div class="app-card-body text-center">
                    <div class="stat-card-icon secondary mx-auto"><i class="bi bi-binoculars"></i></div>
                    <h5 class="fw-semibold">Investigador</h5>
                    <p class="text-muted small mb-0">Registra hallazgos de campo y documenta especies.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="app-card role-card h-100">
                <div class="app-card-body text-center">
                    <div class="stat-card-icon info mx-auto"><i class="bi bi-globe-americas"></i></div>
                    <h5 class="fw-semibold">Público</h5>
                    <p class="text-muted small mb-0">Consulta la biodiversidad registrada sin iniciar sesión.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <p class="page-header-subtitle">Resumen general del sistema</p>
        </div>
        <div class="page-header-actions">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bar-chart-line me-1"></i>Ver reportes
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl">
            <div class="stat-card">
                <div class="stat-card-icon primary"><i class="bi bi-bug"></i></div>
                <div class="stat-card-label">Total especies</div>
                <div class="stat-card-value">@totalEspecies.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="stat-card">
                <div class="stat-card-icon secondary"><i class="bi bi-flower2"></i></div>
                <div class="stat-card-label">Flora</div>
                <div class="stat-card-value">@totalFlora.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="stat-card">
                <div class="stat-card-icon info"><i class="bi bi-binoculars"></i></div>
                <div class="stat-card-label">Fauna</div>
                <div class="stat-card-value">@totalFauna.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="stat-card">
                <div class="stat-card-icon warning"><i class="bi bi-moisture"></i></div>
                <div class="stat-card-label">Hongos</div>
                <div class="stat-card-value">@totalHongos.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="stat-card">
                <div class="stat-card-icon primary"><i class="bi bi-person-badge"></i></div>
                <div class="stat-card-label">Investigadores</div>
                <div class="stat-card-value">@totalInvestigadores.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-card-icon secondary"><i class="bi bi-tree"></i></div>
                <div class="stat-card-label">Reservas naturales</div>
                <div class="stat-card-value">@totalReservas.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-card-icon info"><i class="bi bi-journal-text"></i></div>
                <div class="stat-card-label">Registros totales</div>
                <div class="stat-card-value">@totalRegistros.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="app-card h-100">
                <div class="app-card-header">
                    <h6><i class="bi bi-lightning me-2"></i>Accesos rápidos</h6>
                </div>
                <div class="app-card-body py-2">
                    <a asp-controller="Species" asp-action="Create" class="quick-link">
                        <div class="quick-link-icon"><i class="bi bi-plus-lg"></i></div>
                        <div class="quick-link-text"><strong>Nueva especie</strong><span>Registrar en catálogo</span></div>
                    </a>
                    <a asp-controller="Records" asp-action="Create" class="quick-link">
                        <div class="quick-link-icon"><i class="bi bi-journal-plus"></i></div>
                        <div class="quick-link-text"><strong>Nuevo registro</strong><span>Documentar hallazgo</span></div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="app-card h-100">
                <div class="app-card-header">
                    <h6>Registros por región</h6>
                </div>
                <div class="app-card-body">
                    <div class="chart-container">
                        <canvas id="chartRegiones"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="app-card h-100">
                <div class="app-card-header">
                    <h6>Especies por estado de conservación</h6>
                </div>
                <div class="app-card-body">
                    <div class="chart-container">
                        <canvas id="chartEstados"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card table-card">
        <div class="app-card-header">
            <h6><i class="bi bi-clock-history me-2"></i>Actividad reciente</h6>
            <a asp-controller="Records" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos</a>
        </div>
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>Especie</th>
                        <th>Investigador</th>
                        <th>Ubicación</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!registrosRecientes.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state py-4">
                                    <i class="bi bi-inbox"></i>
                                    <p class="mb-0">No hay registros recientes</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in registrosRecientes)
                    {
                        <tr>
                            <td class="fw-medium">@r.Species?.CommonName</td>
                            <td>@r.Researcher?.Name</td>
                            <td>@r.Location?.PlaceName</td>
                            <td>@r.DiscoveryDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
            Chart.defaults.color = '#6b7280';

            const regionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                registrosPorRegion.Select(r => new { label = (string)r.Region, value = (int)r.Total })));
            const estadoData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                especiesPorEstado.Select(e => new { label = (string)e.Code, value = (int)e.Total })));

            if (regionData.length) {
                new Chart(document.getElementById('chartRegiones'), {
                    type: 'bar',
                    data: {
                        labels: regionData.map(d => d.label),
                        datasets: [{
                            label: 'Registros',
                            data: regionData.map(d => d.value),
                            backgroundColor: 'rgba(64, 145, 108, 0.7)',
                            borderColor: '#40916c',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f3f4f6' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            if (estadoData.length) {
                new Chart(document.getElementById('chartEstados'), {
                    type: 'doughnut',
                    data: {
                        labels: estadoData.map(d => d.label),
                        datasets: [{
                            data: estadoData.map(d => d.value),
                            backgroundColor: ['#1b4332','#40916c','#52b788','#74c69d','#95d5b2','#b7e4c7','#d8f3dc','#0369a1'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { boxWidth: 12, padding: 12 } } }
                    }
                });
            }
        </script>
    }
}
