@model BioGamaEcuador.Models.Family

@{
    ViewData["Title"] = "Detalle de familia";
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Model.Name</h4>
        <p class="text-muted mb-0">Detalles de la clasificacion biologica</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>

<div class="app-card">
    <div class="app-card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Nombre</span>
                    <span class="detail-value">@Model.Name</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Reino</span>
                    <span class="detail-value">@Model.Kingdom</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value">
                        <span class="badge @(Model.IsActive ? "badge-soft-success" : "badge-soft-secondary")">
                            @(Model.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Fecha de creacion</span>
                    <span class="detail-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
</div>
