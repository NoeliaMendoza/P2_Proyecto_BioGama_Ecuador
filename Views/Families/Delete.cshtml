@model BioGamaEcuador.Models.Family

@{
    ViewData["Title"] = "Eliminar familia";
}

<div class="page-header mb-4">
    <h4 class="fw-bold mb-1">Eliminar familia</h4>
    <p class="text-muted mb-0">Esta accion no se puede deshacer</p>
</div>

<div class="app-card border-danger">
    <div class="app-card-body p-4 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size:3rem"></i>
        </div>
        <h5 class="mb-3">Esta seguro de eliminar esta familia?</h5>
        <p class="text-muted mb-4">Se eliminara permanentemente el registro <strong>@Model.Name</strong> del reino <strong>@Model.Kingdom</strong>.</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2 justify-content-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Eliminar definitivamente
                </button>
            </div>
        </form>
    </div>
</div>
