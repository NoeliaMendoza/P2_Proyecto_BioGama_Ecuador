@model List<BioGamaEcuador.Models.Family>

@{
    ViewData["Title"] = "Familias";
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Familias</h4>
        <p class="text-muted mb-0">Clasificacion biologica de las especies</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva familia
            </a>
        }
    </div>
</div>

<div class="app-card filter-card mb-4">
    <div class="app-card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">Buscar</label>
                    <input type="text" name="busqueda" class="form-control" placeholder="Nombre de la familia..." value="@ViewBag.Busqueda" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Reino</label>
                    <select name="reino" class="form-select">
                        <option value="">Todos los reinos</option>
                        @foreach (var k in (List<string>?)ViewBag.Kingdoms ?? new List<string>())
                        {
                            <option value="@k" selected="@(ViewBag.ReinoFiltro == k)">@k</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card">
    <div class="table-card">
        <table class="app-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Reino</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th class="actions-cell">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium">@item.Name</td>
                        <td>@item.Kingdom</td>
                        <td>
                            <span class="badge @(item.IsActive ? "badge-soft-success" : "badge-soft-secondary")">
                                @(item.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="actions-cell">
                            <div class="btn-action-group">
                                <a class="btn-action view" asp-action="Details" asp-route-id="@item.Id" title="Ver" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
                                {
                                    <a class="btn-action edit" asp-action="Edit" asp-route-id="@item.Id" title="Editar" data-bs-toggle="tooltip"><i class="bi bi-pencil"></i></a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a class="btn-action delete" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar" data-bs-toggle="tooltip"><i class="bi bi-trash"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3" aria-label="Paginacion">
    <ul class="pagination justify-content-center">
        @{
            int paginaActual = (int)ViewBag.PaginaActual;
            int totalPaginas = (int)ViewBag.TotalPaginas;
            int rango = 9;
            int inicio = Math.Max(1, paginaActual - rango);
            int fin = Math.Min(totalPaginas, paginaActual + rango);
        }

        @* « Primera *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-busqueda="@ViewBag.Busqueda"
               asp-route-reino="@ViewBag.ReinoFiltro">&laquo;</a>
        </li>

        @* ‹ Anterior *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reino="@ViewBag.ReinoFiltro">&lsaquo;</a>
        </li>

        @* … izquierdo *@
        @if (inicio > 1)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* Rango central *@
        @for (int i = inicio; i <= fin; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@ViewBag.Busqueda"
                   asp-route-reino="@ViewBag.ReinoFiltro">@i</a>
            </li>
        }

        @* … derecho *@
        @if (fin < totalPaginas)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* › Siguiente *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reino="@ViewBag.ReinoFiltro">&rsaquo;</a>
        </li>

        @* » Ultima *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reino="@ViewBag.ReinoFiltro">&raquo;</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Pagina @ViewBag.PaginaActual de @ViewBag.TotalPaginas</p>
</nav>
