@model List<BioGamaEcuador.Models.NaturalReserve>

@{
    ViewData["Title"] = "Reservas naturales";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Reservas naturales</h1>
        <p class="page-header-subtitle">Áreas protegidas y reservas registradas</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva reserva
            </a>
        }
    </div>
</div>

<div class="filter-card">
    <div class="app-card">
        <div class="app-card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <input type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre…"
                               value="@ViewBag.Busqueda" />
                    </div>
                    <div class="col-12 col-md-4">
                        <select name="region" class="form-select">
                            <option value="">Todas las regiones</option>
                            @foreach (var r in (List<string>?)ViewBag.Regiones ?? new List<string>())
                            {
                                <option value="@r" selected="@(ViewBag.RegionFiltro == r)">@r</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-tree me-2"></i>Listado de reservas</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Región</th>
                        <th>Superficie (ha)</th>
                        <th>Año creación</th>
                        <th>Estado</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Region</td>
                            <td>@item.SurfaceHectares.ToString("N2")</td>
                            <td>@item.YearCreated</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-soft-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger">Inactiva</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <div class="btn-action-group">
                                    @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
                                    {
                                        <a class="btn-action edit" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a class="btn-action view" asp-action="Details" asp-route-id="@item.Id" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a class="btn-action delete" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No hay reservas registradas</h5>
                    <p>Comience creando una nueva reserva natural.</p>
                </div>
            }
        </div>
    </div>
</div>

<nav class="mt-3" aria-label="Paginación">
    <ul class="pagination justify-content-center">
        @{
            int paginaActual = (int)ViewBag.PaginaActual;
            int totalPaginas = (int)ViewBag.TotalPaginas;
            int rango = 9;
            int inicio = Math.Max(1, paginaActual - rango);
            int fin = Math.Min(totalPaginas, paginaActual + rango);
        }

        @* « Primera *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-busqueda="@ViewBag.Busqueda"
               asp-route-region="@ViewBag.RegionFiltro">&laquo;</a>
        </li>

        @* ‹ Anterior *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-region="@ViewBag.RegionFiltro">&lsaquo;</a>
        </li>

        @* … izquierdo *@
        @if (inicio > 1)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* Rango central *@
        @for (int i = inicio; i <= fin; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@ViewBag.Busqueda"
                   asp-route-region="@ViewBag.RegionFiltro">@i</a>
            </li>
        }

        @* … derecho *@
        @if (fin < totalPaginas)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* › Siguiente *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-region="@ViewBag.RegionFiltro">&rsaquo;</a>
        </li>

        @* » Última *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-region="@ViewBag.RegionFiltro">&raquo;</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas</p>
</nav>
