@model BioGamaEcuador.Models.NaturalReserve

@{
    ViewData["Title"] = "Eliminar reserva natural";
}

<div class="delete-card">
    <div class="app-card">
        <div class="app-card-body text-center py-5">
            <div class="delete-icon mx-auto">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h4 class="mt-3">¿Está seguro de que desea eliminar esta reserva natural?</h4>
            <p class="text-muted mb-4">Esta acción desactivará la reserva. No se eliminará permanentemente.</p>

            <dl class="row text-start mx-auto" style="max-width:500px;">
                <dt class="col-sm-5 text-muted">Nombre</dt>
                <dd class="col-sm-7">@Model.Name</dd>
                <dt class="col-sm-5 text-muted">Región</dt>
                <dd class="col-sm-7">@Model.Region</dd>
                <dt class="col-sm-5 text-muted">Superficie</dt>
                <dd class="col-sm-7">@Model.SurfaceHectares.ToString("N2") ha</dd>
                <dt class="col-sm-5 text-muted">Año de creación</dt>
                <dd class="col-sm-7">@Model.YearCreated</dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger me-2"><i class="bi bi-trash me-1"></i>Eliminar</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </form>
        </div>
    </div>
</div>
