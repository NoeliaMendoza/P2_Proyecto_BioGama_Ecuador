@model List<BioGamaEcuador.Models.Species>

@{
    ViewData["Title"] = "Catálogo de Especies";
    }

<p class="text-muted mb-3">
    Explora la biodiversidad registrada en reservas naturales del Ecuador.
    Consulta fichas técnicas de flora, fauna y hongos sin necesidad de iniciar sesión.
</p>
<div class="d-flex gap-2 mb-3">
    <span class="badge badge-soft-primary fs-6 px-3 py-2">
        <i class="bi bi-collection me-1"></i>@ViewBag.TotalEspecies especies
    </span>
</div>
    <div class="app-card filter-card mb-4">
        <div class="app-card-body">
            <form method="get" asp-controller="Public" asp-action="Catalogo">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="busqueda" class="form-control border-start-0 ps-0"
                                   placeholder="Nombre común o científico…" value="@ViewBag.Busqueda" />
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label">Familia</label>
                        <select name="familia" class="form-select">
                            <option value="">Todas</option>
                            @foreach (var f in (List<string>)ViewBag.Familias)
                            {
                                <option value="@f" selected="@(ViewBag.FamiliaFiltro == f)">@f</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            @foreach (var e in (List<string>)ViewBag.Estados)
                            {
                                <option value="@e" selected="@(ViewBag.EstadoFiltro == e)">@e</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label">Endémica</label>
                        <select name="endemica" class="form-select">
                            <option value="">Todas</option>
                            <option value="true" selected="@(ViewBag.EndémicaFiltro == true)">Sí</option>
                            <option value="false" selected="@(ViewBag.EndémicaFiltro == false)">No</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                        <a asp-controller="Public" asp-action="Catalogo" class="btn btn-outline-secondary w-100">Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="app-card">
            <div class="empty-state">
                <i class="bi bi-search"></i>
                <h5>No se encontraron especies</h5>
                <p class="mb-3">Prueba con otros filtros o consulta el catálogo completo.</p>
                <a asp-controller="Public" asp-action="Catalogo" class="btn btn-primary btn-sm">
                    Ver todas las especies
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="species-grid">
            @foreach (var sp in Model)
            {
                var statusCode = sp.ConservationStatus?.Code ?? "";
                var statusBadge = statusCode switch
                {
                    "CR" or "EN" => "badge-soft-danger",
                    "VU" => "badge-soft-warning",
                    "LC" => "badge-soft-success",
                    _ => "badge-soft-info"
                };

                <article class="species-card">
                    <div class="species-card-image">
                        @if (!string.IsNullOrWhiteSpace(sp.ImageUrl))
                        {
                            var imageUrl = sp.ImageUrl.Trim();
                            var imageSrc = imageUrl;
                            var isAbsolute = Uri.TryCreate(imageUrl, UriKind.Absolute, out _);
                            if (isAbsolute)
                            {
                                imageSrc = imageUrl.Contains(" ") ? imageUrl.Replace(" ", "%20") : imageUrl;
                            }
                            else
                            {
                                if (!imageUrl.StartsWith("~/") && !imageUrl.StartsWith("/"))
                                {
                                    imageUrl = "~/images/" + imageUrl.TrimStart('/');
                                }
                                imageSrc = Url.Content(imageUrl);
                            }
                            <img src="@imageSrc" alt="@sp.CommonName" loading="lazy" />
                        }
                        else
                        {
                            <div class="species-card-image-placeholder">
                                <i class="bi bi-image"></i>
                                <span>@(sp.Family?.Name ?? "Sin imagen")</span>
                            </div>
                        }
                        @if (sp.ConservationStatus != null)
                        {
                            <span class="species-card-status badge @statusBadge">@sp.ConservationStatus.Code</span>
                        }
                    </div>

                    <div class="species-card-body">
                        <h2 class="species-card-title">@sp.CommonName</h2>
                        <p class="species-card-scientific">@sp.ScientificName</p>

                        <div class="species-card-badges">
                            @if (sp.Family != null)
                            {
                                <span class="badge badge-soft-secondary">@sp.Family.Name</span>
                            }
                            @if (sp.IsEndemic)
                            {
                                <span class="badge badge-soft-primary">
                                    <i class="bi bi-geo-alt me-1"></i>Endémica
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(sp.Description))
                        {
                            <p class="species-card-desc">@sp.Description</p>
                        }

                        <div class="species-card-footer">
                            <span class="species-card-meta">
                                <i class="bi bi-shield-check"></i>
                                @(sp.ConservationStatus?.Name ?? "Sin estado")
                            </span>
                            <a asp-controller="Public" asp-action="DetalleEspecie" asp-route-id="@sp.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>Ver ficha
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    @{
        int paginaActual = (int)ViewBag.PaginaActual;
        int totalPaginas = (int)ViewBag.TotalPaginas;
        int rango = 9;
        int inicio = Math.Max(1, paginaActual - rango);
        int fin = Math.Min(totalPaginas, paginaActual + rango);
    }
    @if (totalPaginas > 1)
    {
        <nav class="app-pagination" aria-label="Paginación catálogo">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Public" asp-action="Catalogo" asp-route-pagina="1"
                       asp-route-busqueda="@ViewBag.Busqueda" asp-route-familia="@ViewBag.FamiliaFiltro"
                       asp-route-estado="@ViewBag.EstadoFiltro" asp-route-endemica="@ViewBag.EndémicaFiltro">&laquo;</a>
                </li>
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Public" asp-action="Catalogo"
                       asp-route-pagina="@(paginaActual - 1)" asp-route-busqueda="@ViewBag.Busqueda"
                       asp-route-familia="@ViewBag.FamiliaFiltro" asp-route-estado="@ViewBag.EstadoFiltro"
                       asp-route-endemica="@ViewBag.EndémicaFiltro">&lsaquo;</a>
                </li>
                @if (inicio > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                @for (int i = inicio; i <= fin; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-controller="Public" asp-action="Catalogo" asp-route-pagina="@i"
                           asp-route-busqueda="@ViewBag.Busqueda" asp-route-familia="@ViewBag.FamiliaFiltro"
                           asp-route-estado="@ViewBag.EstadoFiltro" asp-route-endemica="@ViewBag.EndémicaFiltro">@i</a>
                    </li>
                }
                @if (fin < totalPaginas)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-controller="Public" asp-action="Catalogo"
                       asp-route-pagina="@(paginaActual + 1)" asp-route-busqueda="@ViewBag.Busqueda"
                       asp-route-familia="@ViewBag.FamiliaFiltro" asp-route-estado="@ViewBag.EstadoFiltro"
                       asp-route-endemica="@ViewBag.EndémicaFiltro">&rsaquo;</a>
                </li>
                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-controller="Public" asp-action="Catalogo" asp-route-pagina="@totalPaginas"
                       asp-route-busqueda="@ViewBag.Busqueda" asp-route-familia="@ViewBag.FamiliaFiltro"
                       asp-route-estado="@ViewBag.EstadoFiltro" asp-route-endemica="@ViewBag.EndémicaFiltro">&raquo;</a>
                </li>
            </ul>
            <p class="app-pagination-info">Página @paginaActual de @totalPaginas</p>
        </nav>
    }

