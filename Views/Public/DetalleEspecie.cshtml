@model BioGamaEcuador.Models.Species

@{
    ViewData["Title"] = Model.CommonName;
    
    var statusCode = Model.ConservationStatus?.Code ?? "";
    var statusBadge = statusCode switch
    {
        "CR" or "EN" => "badge-soft-danger",
        "VU" => "badge-soft-warning",
        "LC" => "badge-soft-success",
        _ => "badge-soft-info"
    };
}

<div class="public-content">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Public" asp-action="Catalogo">Catálogo</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.CommonName</li>
        </ol>
    </nav>

    <div class="public-detail-header">
        <div>
            <h1 class="public-detail-title">@Model.CommonName</h1>
            <p class="public-detail-scientific">@Model.ScientificName</p>
            <p class="public-detail-meta">
                <i class="bi bi-calendar3 me-1"></i>Registrado: @Model.CreatedAt.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="public-detail-badges">
            @if (Model.ConservationStatus != null)
            {
                <span class="badge @statusBadge">@Model.ConservationStatus.Name (@Model.ConservationStatus.Code)</span>
            }
            @if (Model.IsEndemic)
            {
                <span class="badge badge-soft-primary">
                    <i class="bi bi-geo-alt me-1"></i>Endémica
                </span>
            }
        </div>
    </div>

    <div class="app-card detail-card overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-md-5">
                <div class="detail-image">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        var imageUrl = Model.ImageUrl.Trim();
                        var imageSrc = imageUrl;
                        var isAbsolute = Uri.TryCreate(imageUrl, UriKind.Absolute, out _);
                        if (isAbsolute)
                        {
                            imageSrc = imageUrl.Contains(" ") ? imageUrl.Replace(" ", "%20") : imageUrl;
                        }
                        else
                        {
                            if (!imageUrl.StartsWith("~/") && !imageUrl.StartsWith("/"))
                            {
                                imageUrl = "~/images/" + imageUrl.TrimStart('/');
                            }
                            imageSrc = Url.Content(imageUrl);
                        }
                        <img src="@imageSrc" alt="@Model.CommonName" class="w-100" />
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-image" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="mt-2 small mb-0">@(Model.Family?.Name ?? "Sin imagen disponible")</p>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-7">
                <div class="app-card-body">
                    <h2 class="h5 fw-semibold mb-3">Ficha técnica</h2>
                    <table class="table table-borderless public-spec-table mb-0">
                        <tbody>
                            <tr>
                                <th>Nombre científico</th>
                                <td><em>@Model.ScientificName</em></td>
                            </tr>
                            <tr>
                                <th>Nombre común</th>
                                <td>@Model.CommonName</td>
                            </tr>
                            <tr>
                                <th>Familia</th>
                                <td>@(Model.Family?.Name ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Estado de conservación</th>
                                <td>@(Model.ConservationStatus?.Name ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Endémica</th>
                                <td>@(Model.IsEndemic ? "Sí" : "No")</td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <tr>
                                    <th>Descripción</th>
                                    <td>@Model.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Public" asp-action="Catalogo" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
        </a>
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a asp-controller="Species" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Species" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </a>
            }
        }
    </div>
</div>
