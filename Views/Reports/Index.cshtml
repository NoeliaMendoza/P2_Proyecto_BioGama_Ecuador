@{
    ViewData["Title"] = "Reportes";
    var resumen = ViewBag.Resumen;
}

<div class="page-header">
    <div>
        <p class="page-header-subtitle">Análisis y estadísticas del sistema</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon primary"><i class="bi bi-bug"></i></div>
            <div class="stat-card-label">Especies</div>
            <div class="stat-card-value">@resumen.TotalEspecies</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon info"><i class="bi bi-journal-text"></i></div>
            <div class="stat-card-label">Registros</div>
            <div class="stat-card-value">@resumen.TotalRegistros</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon secondary"><i class="bi bi-person-badge"></i></div>
            <div class="stat-card-label">Investigadores</div>
            <div class="stat-card-value">@resumen.TotalInvestigadores</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon warning"><i class="bi bi-tree"></i></div>
            <div class="stat-card-label">Reservas</div>
            <div class="stat-card-value">@resumen.TotalReservas</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header"><h6>Registros por región</h6></div>
            <div class="app-card-body"><div class="chart-container"><canvas id="chartRegRegion"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header"><h6>Registros por año</h6></div>
            <div class="app-card-body"><div class="chart-container"><canvas id="chartRegAnio"></canvas></div></div>
        </div>
    </div>
</div>

<div class="row g-3">

    <div class="col-md-6">
        <div class="app-card table-card h-100">
            <div class="app-card-header"><h6>Riqueza de especies por región</h6></div>
            <div class="table-responsive">
                <table class="table app-table">
                    <thead><tr><th>Región</th><th class="text-end">Especies distintas</th></tr></thead>
                    <tbody>
                        @foreach (var item in ViewBag.EspeciesPorRegion)
                        {
                            <tr>
                                <td>@item.Region</td>
                                <td class="text-end fw-medium">@item.EspeciesDistintas.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card table-card h-100">
            <div class="app-card-header"><h6>Top 10 especies más registradas</h6></div>
            <div class="table-responsive">
                <table class="table app-table">
                    <thead><tr><th>#</th><th>Especie</th><th class="text-end">Registros</th></tr></thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var item in ViewBag.TopEspecies)
                        {
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>@item.Especie</td>
                                <td class="text-end fw-medium">@item.TotalRegistros.ToString("N0")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card table-card h-100">
            <div class="app-card-header"><h6>Especies por estado de conservación</h6></div>
            <div class="table-responsive">
                <table class="table app-table">
                    <thead><tr><th>Código</th><th>Estado</th><th class="text-end">Especies</th></tr></thead>
                    <tbody>
                        @foreach (var item in ViewBag.EspeciesPorEstado)
                        {
                            <tr>
                                <td><span class="badge badge-soft-secondary">@item.Code</span></td>
                                <td>@item.Name</td>
                                <td class="text-end fw-medium">@item.Total.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card table-card h-100">
            <div class="app-card-header"><h6>Top 10 investigadores</h6></div>
            <div class="table-responsive">
                <table class="table app-table">
                    <thead><tr><th>#</th><th>Nombre</th><th>Institución</th><th class="text-end">Registros</th></tr></thead>
                    <tbody>
                        @{ int j = 1; }
                        @foreach (var item in ViewBag.TopInvestigadores)
                        {
                            <tr>
                                <td class="text-muted">@j</td>
                                <td>@item.Name</td>
                                <td class="text-muted small">@item.Institution</td>
                                <td class="text-end fw-medium">@item.TotalRegistros.ToString("N0")</td>
                            </tr>
                            j++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.color = '#6b7280';

        const regRegion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((IEnumerable<dynamic>)ViewBag.RegistrosPorRegion).Select(r => new { label = (string)r.Region, value = (int)r.Total })));
        const regAnio = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((IEnumerable<dynamic>)ViewBag.RegistrosPorAnio).Select(r => new { label = r.Anio.ToString(), value = (int)r.Total })));

        if (regRegion.length) {
            new Chart(document.getElementById('chartRegRegion'), {
                type: 'bar',
                data: {
                    labels: regRegion.map(d => d.label),
                    datasets: [{ label: 'Registros', data: regRegion.map(d => d.value),
                        backgroundColor: 'rgba(27, 67, 50, 0.75)', borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, grid: { color: '#f3f4f6' } }, x: { grid: { display: false } } } }
            });
        }

        if (regAnio.length) {
            new Chart(document.getElementById('chartRegAnio'), {
                type: 'line',
                data: {
                    labels: regAnio.map(d => d.label),
                    datasets: [{ label: 'Registros', data: regAnio.map(d => d.value),
                        borderColor: '#40916c', backgroundColor: 'rgba(64, 145, 108, 0.1)',
                        fill: true, tension: 0.3, pointRadius: 4 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, grid: { color: '#f3f4f6' } }, x: { grid: { display: false } } } }
            });
        }
    </script>
}
