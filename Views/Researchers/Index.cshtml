@model List<BioGamaEcuador.Models.Researcher>

@{
    ViewData["Title"] = "Investigadores";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Investigadores</h1>
        <p class="page-header-subtitle">Científicos y colaboradores del proyecto</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nuevo investigador
            </a>
        }
    </div>
</div>

<div class="filter-card">
    <div class="app-card">
        <div class="app-card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <input type="text" name="nombre" class="form-control" placeholder="Buscar por nombre…"
                               value="@ViewBag.Nombre" />
                    </div>
                    <div class="col-12 col-md-5">
                        <input type="text" name="institucion" class="form-control" placeholder="Buscar por institución…"
                               value="@ViewBag.Institucion" />
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-people me-2"></i>Listado de investigadores</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Institución</th>
                        <th>Correo</th>
                        <th>Especialidad</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Name</td>
                            <td>@item.Institution</td>
                            <td>@item.Email</td>
                            <td>@item.Specialty</td>
                            <td class="actions-cell">
                                <div class="btn-action-group">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a class="btn-action edit" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a class="btn-action view" asp-action="Details" asp-route-id="@item.Id" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a class="btn-action delete" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No hay investigadores registrados</h5>
                    <p>Comience creando un nuevo investigador.</p>
                </div>
            }
        </div>
    </div>
</div>

<nav class="mt-3" aria-label="Paginación">
    <ul class="pagination justify-content-center">
        @{
            int paginaActual = (int)ViewBag.PaginaActual;
            int totalPaginas = (int)ViewBag.TotalPaginas;
            int rango = 9;
            int inicio = Math.Max(1, paginaActual - rango);
            int fin = Math.Min(totalPaginas, paginaActual + rango);
        }

        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-nombre="@ViewBag.Nombre"
               asp-route-institucion="@ViewBag.Institucion">&laquo;</a>
        </li>

        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
               asp-route-nombre="@ViewBag.Nombre" asp-route-institucion="@ViewBag.Institucion">&lsaquo;</a>
        </li>

        @if (inicio > 1)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @for (int i = inicio; i <= fin; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-nombre="@ViewBag.Nombre"
                   asp-route-institucion="@ViewBag.Institucion">@i</a>
            </li>
        }

        @if (fin < totalPaginas)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
               asp-route-nombre="@ViewBag.Nombre" asp-route-institucion="@ViewBag.Institucion">&rsaquo;</a>
        </li>

        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas" asp-route-nombre="@ViewBag.Nombre"
               asp-route-institucion="@ViewBag.Institucion">&raquo;</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas</p>
</nav>
