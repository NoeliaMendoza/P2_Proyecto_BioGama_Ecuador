@model BioGamaEcuador.Models.Researcher
@{ ViewData["Title"] = Model.Name; }

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex align-items-center">
        <i class="bi bi-person-badge me-2 fs-5"></i>
        <h5 class="mb-0">@Model.Name</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div class="fs-1"><i class="bi bi-building text-primary"></i></div>
                    <div class="small text-muted mt-1">Institución</div>
                    <div class="fw-bold">@Model.Institution</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div class="fs-1"><i class="bi bi-gear text-success"></i></div>
                    <div class="small text-muted mt-1">Especialidad</div>
                    <div class="fw-bold">@Model.Specialty</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div class="fs-1"><i class="bi bi-envelope text-danger"></i></div>
                    <div class="small text-muted mt-1">Correo</div>
                    <div class="fw-bold"><a href="mailto:@Model.Email">@Model.Email</a></div>
                </div>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3"><i class="bi bi-calendar-event me-1 text-muted"></i>Registrado el</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3"><i class="bi bi-toggle-on me-1 text-muted"></i>Estado</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                }
            </dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Eliminar
            </a>
        </div>
    </div>
</div>
