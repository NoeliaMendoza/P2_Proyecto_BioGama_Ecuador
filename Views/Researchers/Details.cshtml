@model BioGamaEcuador.Models.Researcher
@{ ViewData["Title"] = Model.Name; }

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="app-card detail-card overflow-hidden">
    <div class="row g-0">
        <div class="col-md-4 d-flex align-items-center justify-content-center bg-light p-4">
            <div class="text-center">
                <div class="stat-card-icon primary mx-auto mb-3" style="width:72px;height:72px;font-size:2rem;">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.Name</h4>
                <p class="text-muted small mb-0">@Model.Institution</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="app-card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-sm-4">
                        <div class="text-center p-3 rounded-3 border">
                            <div class="fs-3 text-primary"><i class="bi bi-building"></i></div>
                            <div class="small text-muted mt-1">Institución</div>
                            <div class="fw-bold small">@Model.Institution</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-center p-3 rounded-3 border">
                            <div class="fs-3 text-success"><i class="bi bi-gear"></i></div>
                            <div class="small text-muted mt-1">Especialidad</div>
                            <div class="fw-bold small">@Model.Specialty</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-center p-3 rounded-3 border">
                            <div class="fs-3 text-danger"><i class="bi bi-envelope"></i></div>
                            <div class="small text-muted mt-1">Correo</div>
                            <div class="fw-bold small"><a href="mailto:@Model.Email">@Model.Email</a></div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <dl class="row mb-0">
                    <dt class="col-sm-3"><i class="bi bi-calendar-event me-1 text-muted"></i>Registrado el</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-3"><i class="bi bi-toggle-on me-1 text-muted"></i>Estado</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                        }
                    </dd>
                </dl>

                <div class="mt-4 d-flex gap-2">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Eliminar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
