@model BioGamaEcuador.Models.Location
@{ ViewData["Title"] = Model.PlaceName; }

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Volver al listado</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>@Model.PlaceName</h5>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div style="font-size:2rem;"><i class="bi bi-arrow-up text-secondary"></i></div>
                    <div class="small text-muted mt-1">Altitud</div>
                    <div class="fw-bold fs-5">@(Model.Altitude > 0 ? $"{Model.Altitude} m.s.n.m." : "—")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div style="font-size:2rem;"><i class="bi bi-globe text-info"></i></div>
                    <div class="small text-muted mt-1">Latitud</div>
                    <div class="fw-bold fs-5">@(Model.Latitude != 0 ? $"{Model.Latitude}°" : "—")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div style="font-size:2rem;"><i class="bi bi-globe text-info"></i></div>
                    <div class="small text-muted mt-1">Longitud</div>
                    <div class="fw-bold fs-5">@(Model.Longitude != 0 ? $"{Model.Longitude}°" : "—")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-light p-3 text-center h-100">
                    <div style="font-size:2rem;"><i class="bi bi-tree text-success"></i></div>
                    <div class="small text-muted mt-1">Reserva natural</div>
                    <div class="fw-bold fs-5">@(Model.NaturalReserve?.Name ?? "—")</div>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-3">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted"><i class="bi bi-calendar-event me-1"></i>Registrado el</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4 text-muted"><i class="bi bi-toggle-on me-1"></i>Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
            @if (Model.UpdatedAt.HasValue)
            {
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted"><i class="bi bi-calendar-check me-1"></i>Actualizado el</dt>
                        <dd class="col-sm-8">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>
            }
        </div>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Eliminar</a>
        </div>
    </div>
</div>
