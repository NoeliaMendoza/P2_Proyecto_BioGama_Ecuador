@model BioGamaEcuador.Models.Location

@{
    ViewData["Title"] = "Nueva Ubicación";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-geo-alt me-2"></i>Nueva Ubicación</h2>
        <p class="text-muted mb-0">Registre un nuevo punto de muestreo o localidad geográfica</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="PlaceName" class="form-control" placeholder="Nombre del lugar" />
                        <label asp-for="PlaceName"><i class="bi bi-geo-alt me-1"></i>Nombre del lugar</label>
                        <span asp-validation-for="PlaceName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Altitude" class="form-control" placeholder="Altitud" type="number" />
                        <label asp-for="Altitude"><i class="bi bi-arrow-up me-1"></i>Altitud (msnm)</label>
                        <span asp-validation-for="Altitude" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Latitude" class="form-control" placeholder="Latitud" type="number" step="0.000001" />
                        <label asp-for="Latitude"><i class="bi bi-globe me-1"></i>Latitud</label>
                        <span asp-validation-for="Latitude" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Longitude" class="form-control" placeholder="Longitud" type="number" step="0.000001" />
                        <label asp-for="Longitude"><i class="bi bi-globe me-1"></i>Longitud</label>
                        <span asp-validation-for="Longitude" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="NaturalReserveId" class="form-label"><i class="bi bi-tree me-1"></i>Reserva natural</label>
                        <select asp-for="NaturalReserveId" class="form-select" asp-items="ViewBag.NaturalReserveId">
                            <option value="">Seleccione una reserva</option>
                        </select>
                        <span asp-validation-for="NaturalReserveId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"><i class="bi bi-toggle-on me-1"></i>Activo</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
