@model List<BioGamaEcuador.Models.Location>

@{
    ViewData["Title"] = "Ubicaciones";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-geo-alt me-2"></i>Ubicaciones</h2>
        <p class="text-muted mb-0">Puntos de muestreo y localidades geográficas</p>
    </div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>Nueva ubicación
        </a>
    }
</div>

<div class="card filter-card mb-4 shadow-sm">
    <div class="card-body py-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <div class="form-floating">
                        <input type="text" name="busqueda" class="form-control" placeholder="Buscar por lugar"
                               value="@ViewBag.Busqueda" />
                        <label><i class="bi bi-search me-1"></i>Buscar por lugar</label>
                    </div>
                </div>
                <div class="col-7 col-md-4">
                    <div class="form-floating">
                        <select name="reserva" class="form-select">
                            <option value="">Todas las reservas</option>
                            @foreach (var r in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>?)ViewBag.Reservas
                            ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                            {
                                <option value="@r.Value" selected="@(ViewBag.ReservaFiltro == r.Value)">@r.Text</option>
                            }
                        </select>
                        <label><i class="bi bi-tree me-1"></i>Reserva natural</label>
                    </div>
                </div>
                <div class="col-5 col-md-3 d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-table me-1"></i>Listado de ubicaciones</span>
        <span class="badge bg-secondary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lugar</th>
                        <th>Altitud</th>
                        <th>Latitud</th>
                        <th>Longitud</th>
                        <th>Reserva natural</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.PlaceName</td>
                            <td>@(item.Altitude > 0 ? $"{item.Altitude} m" : "—")</td>
                            <td>@(item.Latitude != 0 ? $"{item.Latitude}°" : "—")</td>
                            <td>@(item.Longitude != 0 ? $"{item.Longitude}°" : "—")</td>
                            <td>@(item.NaturalReserve?.Name ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-action-group d-flex gap-1 justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<nav class="mt-3" aria-label="Paginación">
    <ul class="pagination justify-content-center">
        @{
            int paginaActual = (int)ViewBag.PaginaActual;
            int totalPaginas = (int)ViewBag.TotalPaginas;
            int rango = 9;
            int inicio = Math.Max(1, paginaActual - rango);
            int fin = Math.Min(totalPaginas, paginaActual + rango);
        }

        @* « Primera *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-busqueda="@ViewBag.Busqueda"
               asp-route-reserva="@ViewBag.ReservaFiltro">&laquo;</a>
        </li>

        @* ‹ Anterior *@
        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reserva="@ViewBag.ReservaFiltro">&lsaquo;</a>
        </li>

        @* … izquierdo *@
        @if (inicio > 1)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* Rango central *@
        @for (int i = inicio; i <= fin; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@ViewBag.Busqueda"
                   asp-route-reserva="@ViewBag.ReservaFiltro">@i</a>
            </li>
        }

        @* … derecho *@
        @if (fin < totalPaginas)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* › Siguiente *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reserva="@ViewBag.ReservaFiltro">&rsaquo;</a>
        </li>

        @* » Última *@
        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas"
               asp-route-busqueda="@ViewBag.Busqueda" asp-route-reserva="@ViewBag.ReservaFiltro">&raquo;</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas</p>
</nav>
