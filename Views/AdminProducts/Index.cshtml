@model IReadOnlyList<BioGamaEcuador.Models.Sales.PhysicalProduct>
@{ViewData["Title"]="Productos físicos";Layout="_LayoutAdmin";}
<div class="page-header"><div><h1 class="page-header-title">Productos físicos</h1></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo producto</a></div><div class="app-card filter-card mb-3"><div class="app-card-body"><form class="row g-2" method="get"><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar nombre"/></div><div class="col-md-3"><input name="sku" value="@ViewBag.Sku" class="form-control" placeholder="SKU"/></div><div class="col-md-3"><div class="form-check pt-2"><input name="lowStock" value="true" checked="@ViewBag.LowStock" class="form-check-input" type="checkbox"/><label class="form-check-label">Solo stock bajo</label></div></div><div class="col-md-2"><button class="btn btn-primary">Filtrar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div></form></div></div><div class="app-card table-card"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Nombre</th><th>SKU</th><th>Stock</th><th>Precio</th><th>Estado</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="text-center py-4">No hay productos.</td></tr>}@foreach(var p in Model){var low=p.Stock-p.ReservedStock<=p.MinStock;<tr><td class="fw-semibold">@p.Name</td><td>@p.SKU</td><td><span class="@(low?"text-warning fw-bold":"")">@(p.Stock-p.ReservedStock)/@p.Stock</span></td><td>@p.Price.ToString("C")</td><td><span class="badge @(p.IsActive?"text-bg-success":"text-bg-secondary")">@(p.IsActive?"Activo":"Inactivo")</span></td><td><a class="btn-action edit" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i></a> <a class="btn-action delete" asp-action="DeleteConfirmation" asp-route-id="@p.Id" title="Eliminar"><i class="bi bi-trash"></i></a></td></tr>}</tbody></table></div></div>
