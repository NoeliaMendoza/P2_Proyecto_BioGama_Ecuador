@model BioGamaEcuador.Models.Admin.ProductFormViewModel
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden"/><div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label">Nombre</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="SKU" class="form-label">SKU</label><input asp-for="SKU" class="form-control"/><span asp-validation-for="SKU" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label">Descripción</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="Price" class="form-label">Precio</label><input asp-for="Price" type="number" step="0.01" class="form-control"/></div><div class="col-md-4"><label asp-for="Stock" class="form-label">Stock inicial / total</label><input asp-for="Stock" class="form-control"/></div><div class="col-md-4"><label asp-for="MinStock" class="form-label">Stock mínimo</label><input asp-for="MinStock" class="form-control"/></div><div class="col-md-6"><label asp-for="SpeciesId" class="form-label">Especie relacionada</label><select asp-for="SpeciesId" asp-items="ViewBag.SpeciesId" class="form-select"><option value="">Ninguna</option></select></div><div class="col-md-6"><label asp-for="ImageUrl" class="form-label">URL imagen</label><input asp-for="ImageUrl" class="form-control"/></div><div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Producto activo</label></div></div></div><div class="form-actions mt-4"><button class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form>
