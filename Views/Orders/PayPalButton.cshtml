@model BioGamaEcuador.Models.Sales.Order
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Pago con PayPal";
    var clientId = Configuration["PayPal:ClientId"] ?? "";
}

<div class="page-header mb-4">
    <h4 class="page-header-title">Pago con PayPal</h4>
    <p class="page-header-subtitle">Orden #@Model.Id.ToString("N").Substring(0, 8).ToUpper()</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="app-card mb-4">
            <div class="app-card-body p-4">
                <div class="row mb-3">
                    <div class="col-6 text-muted">Total</div>
                    <div class="col-6 text-end fw-bold fs-5">$@Model.Total.ToString("N2")</div>
                </div>

                <table class="table table-sm mb-4">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Details)
                        {
                            <tr>
                                <td>@(d.Course?.Title ?? d.PhysicalProduct?.Name ?? "Item")</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">$@d.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div id="paypal-button-container" class="mt-3"></div>
                <div id="paypal-message" class="mt-3"></div>
                <div id="paypal-actions" class="mt-3 d-none">
                    <a asp-action="Checkout" asp-route-orderId="@Model.Id" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-1"></i>Volver al pago
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@clientId&currency=USD"></script>
    <script>
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        paypal.Buttons({
            createOrder: function () {
                return fetch('@Url.Action("CreatePayPalOrder", "Orders")', {
                    method: 'post',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken || ''
                    },
                    body: JSON.stringify({ orderId: '@Model.Id' })
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) throw new Error(data.message);
                    return data.orderId;
                });
            },
            onApprove: function (data) {
                return fetch('@Url.Action("CapturePayPalOrder", "Orders")', {
                    method: 'post',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken || ''
                    },
                    body: JSON.stringify({ payPalOrderId: data.orderID })
                })
                .then(function (res) { return res.json(); })
                .then(function (details) {
                    if (details.success && details.redirect) {
                        window.location.href = details.redirect;
                    } else {
                        document.getElementById('paypal-message').innerHTML =
                            '<div class="alert alert-danger">' + (details.message || 'Error al procesar el pago') + '</div>';
                    }
                });
            },
            onCancel: function () {
                document.getElementById('paypal-message').innerHTML =
                    '<div class="alert alert-warning">Pago cancelado. Puedes volver a intentarlo.</div>';
                document.getElementById('paypal-actions').classList.remove('d-none');
            },
            onError: function (err) {
                document.getElementById('paypal-message').innerHTML =
                    '<div class="alert alert-danger">Error al procesar el pago. Intenta de nuevo.</div>';
                document.getElementById('paypal-actions').classList.remove('d-none');
            }
        }).render('#paypal-button-container');
    </script>
}
