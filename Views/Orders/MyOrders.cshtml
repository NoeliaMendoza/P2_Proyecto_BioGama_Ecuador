@model IEnumerable<BioGamaEcuador.Models.Sales.Order>

@{
    ViewData["Title"] = "Mis Compras";
    Layout = "_Layout";
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Mis Compras</h4>
        <p class="text-muted mb-0">Historial de pedidos, cursos inscritos y estado de pagos</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-mortarboard me-1"></i>Explorar cursos
        </a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-box-seam me-1"></i>Ver productos
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="app-card">
        <div class="empty-state">
            <i class="bi bi-receipt" style="font-size:3rem;color:var(--color-muted)"></i>
            <h5 class="mt-3">No tienes compras aun</h5>
            <p class="mb-3">Cuando realices tu primera compra o te inscribas en un curso, aparecera aqui.</p>
            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-mortarboard me-1"></i>Ver cursos disponibles
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-box-seam me-1"></i>Ver productos
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="app-card">
        <div class="table-card">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Fecha</th>
                        <th>Artículos</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Método</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-monospace">#@o.Id.ToString()[..8].ToUpper()</strong>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <br><small class="text-muted">@o.UserId</small>
                                }
                            </td>
                            <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (o.Details != null && o.Details.Any())
                                {
                                    <span class="badge badge-soft-primary">@o.Details.Count art.</span>
                                    <ul class="list-unstyled mb-0 small mt-1">
                                        @foreach (var d in o.Details.Take(3))
                                        {
                                            var isCourse = d.Course != null;
                                            <li>
                                                @if (isCourse)
                                                {
                                                    <i class="bi bi-mortarboard text-primary me-1"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-box-seam text-success me-1"></i>
                                                }
                                                @(d.Course?.Title ?? d.PhysicalProduct?.Name ?? "Item") x @d.Quantity
                                            </li>
                                        }
                                        @if (o.Details.Count > 3)
                                        {
                                            <li class="text-muted">... y @(o.Details.Count - 3) mas</li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td class="fw-semibold">$@o.Total.ToString("N2", new System.Globalization.CultureInfo("es-EC"))</td>
                            <td>
                                @if (o.Payment != null)
                                {
                                    <span class="badge @(o.Payment.Provider == "PayPal" ? "badge-soft-primary" : "badge-soft-success")">
                                        @if (o.Payment.Provider == "PayPal")
                                        {
                                            <i class="bi bi-paypal me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-phone me-1"></i>
                                        }
                                        @o.Payment.Provider
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">-</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge @(
                                        o.Status switch
                                        {
                                            "Confirmed" or "Delivered" => "badge-soft-success",
                                            "Pending" => "badge-soft-warning",
                                            "Processing" => "badge-soft-info",
                                            "Shipped" => "badge-soft-primary",
                                            "Cancelled" => "badge-soft-secondary",
                                            "Refunded" => "badge-soft-danger",
                                            _ => "badge-soft-info"
                                        })">@(o.Status switch
                                        {
                                            "Confirmed" => "Confirmado",
                                            "Delivered" => "Entregado",
                                            "Pending" => "Pendiente",
                                            "Processing" => "Procesando",
                                            "Shipped" => "Enviado",
                                            "Cancelled" => "Cancelado",
                                            "Refunded" => "Reembolsado",
                                            _ => o.Status
                                        })</span>
                                    @if (o.Payment != null)
                                    {
                                        <span class="badge @(
                                            o.Payment.Status switch
                                            {
                                                "Approved" => "badge-soft-success",
                                                "Pending" => "badge-soft-warning",
                                                "Cancelled" => "badge-soft-secondary",
                                                "Failed" => "badge-soft-danger",
                                                "Expired" => "badge-soft-danger",
                                                "Refunded" => "badge-soft-danger",
                                                _ => "badge-soft-info"
                                            })" style="font-size:10px">Pago: @(o.Payment.Status switch
                                            {
                                                "Approved" => "Aprobado",
                                                "Pending" => "Pendiente",
                                                "Cancelled" => "Cancelado",
                                                "Failed" => "Fallido",
                                                "Expired" => "Expirado",
                                                "Refunded" => "Reembolsado",
                                                _ => o.Payment.Status
                                            })</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="btn-action-group">
                                    <a asp-controller="Orders" asp-action="Confirmation" asp-route-id="@o.Id"
                                       class="btn-action view" title="Ver detalle" data-bs-toggle="tooltip">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (o.Status == "Confirmed" && o.Details.Any(d => d.Course != null))
                                    {
                                        <a asp-controller="MyCourses" asp-action="Index"
                                           class="btn-action primary" title="Ir al curso" data-bs-toggle="tooltip">
                                            <i class="bi bi-mortarboard"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.Pagination != null)
        {
            <nav class="app-pagination" aria-label="Paginacion de pedidos">
                <ul class="pagination justify-content-center flex-wrap">
                    @if (ViewBag.Pagination.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Orders" asp-action="MyOrders"
                               asp-route-page="@(ViewBag.Pagination.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                    @for (int i = 1; i <= ViewBag.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.Pagination.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Orders" asp-action="MyOrders" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (ViewBag.Pagination.CurrentPage < ViewBag.Pagination.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Orders" asp-action="MyOrders"
                               asp-route-page="@(ViewBag.Pagination.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
                <p class="app-pagination-info">Mostrando @ViewBag.Pagination.StartItem - @ViewBag.Pagination.EndItem de @ViewBag.Pagination.TotalItems pedidos</p>
            </nav>
        }
    </div>
}

<style>
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }
    .btn-action-group {
        display: flex;
        gap: 4px;
        justify-content: center;
    }
    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }
    .orders-table thead th {
        background: var(--color-surface-alt, #f5f6fa);
        padding: 12px 16px;
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--color-muted, #6c757d);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--color-border, #e0e4e8);
    }
    .orders-table tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--color-border-light, #eef0f4);
        vertical-align: middle;
    }
    .orders-table tbody tr:hover {
        background: var(--color-surface-alt, #f5f6fa);
    }
    .orders-table tbody tr:last-child td {
        border-bottom: none;
    }
</style>
