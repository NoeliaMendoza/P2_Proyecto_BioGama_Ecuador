@model IEnumerable<BioGamaEcuador.Models.Sales.Enrollment>

@{
    ViewData["Title"] = "Mis Cursos";
    Layout = "_Layout";
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Mis Cursos</h4>
        <p class="text-muted mb-0">Cursos que has adquirido con pago confirmado</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-mortarboard me-1"></i>Explorar cursos
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="app-card">
        <div class="empty-state">
            <i class="bi bi-book" style="font-size:3rem;color:var(--color-muted)"></i>
            <h5 class="mt-3">No tienes cursos inscritos</h5>
            <p class="mb-3">Cuando compres un curso y el pago sea confirmado, aparecera aqui.</p>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-mortarboard me-1"></i>Ver cursos disponibles
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var enrollment in Model)
        {
            var course = enrollment.Course;
            <div class="col-lg-4 col-md-6">
                <div class="app-card h-100">
                    <div class="course-card-img">
                        @if (!string.IsNullOrEmpty(course?.ImageUrl))
                        {
                            <img src="@course.ImageUrl" alt="@course?.Title" />
                        }
                        else
                        {
                            <div class="course-card-placeholder">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                        }
                        <span class="course-card-badge">@course?.Modality</span>
                    </div>
                    <div class="app-card-body p-3">
                        <h6 class="fw-bold mb-1">@course?.Title</h6>
                        @if (!string.IsNullOrEmpty(course?.Instructor))
                        {
                            <p class="text-muted small mb-2">
                                <i class="bi bi-person me-1"></i>@course.Instructor
                            </p>
                        }
                        <div class="d-flex flex-wrap gap-2 small text-muted mb-2">
                            @if (course?.StartDate != null)
                            {
                                <span><i class="bi bi-calendar me-1"></i>@course.StartDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-EC"))</span>
                            }
                            @if (!string.IsNullOrEmpty(course?.Venue))
                            {
                                <span><i class="bi bi-geo-alt me-1"></i>@course.Venue</span>
                            }
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top">
                            <span class="badge badge-soft-success">Activo</span>
                            <small class="text-muted">Comprado el @enrollment.EnrolledAt.ToString("dd/MM/yyyy")</small>
                        </div>
                        <a href="#" class="btn btn-primary w-100 mt-3">
                            <i class="bi bi-play-circle me-1"></i>Acceder al curso
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Styles {
    <style>
        .course-card-img {
            position: relative;
            height: 160px;
            overflow: hidden;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            background: var(--color-surface-alt);
        }
        .course-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .course-card-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: var(--color-muted);
        }
        .course-card-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: var(--color-primary);
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
        }
    </style>
}
