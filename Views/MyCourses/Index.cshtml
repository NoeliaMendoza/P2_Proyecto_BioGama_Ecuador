@model IEnumerable<BioGamaEcuador.Models.Sales.Enrollment>
@using System.Security.Cryptography
@using System.Text

@{
    ViewData["Title"] = "Mis Cursos";
    Layout = "_Layout";

    string MeetingLink(Guid courseId)
    {
        var hash = SHA256.HashData(Encoding.UTF8.GetBytes(courseId.ToString()))[..4];
        var code = Convert.ToHexString(hash).ToLower();
        return $"https://meet.google.com/{code}";
    }
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Mis Cursos</h4>
        <p class="text-muted mb-0">Cursos que has adquirido con pago confirmado</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-mortarboard me-1"></i>Explorar cursos
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="app-card">
        <div class="empty-state">
            <i class="bi bi-book" style="font-size:3rem;color:var(--color-muted)"></i>
            <h5 class="mt-3">No tienes cursos inscritos</h5>
            <p class="mb-3">Cuando compres un curso y el pago sea confirmado, aparecerá aquí.</p>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-mortarboard me-1"></i>Ver cursos disponibles
            </a>
        </div>
    </div>
}
else
{
    <div class="course-grid">
        @foreach (var enrollment in Model)
        {
            var course = enrollment.Course;
            var isVirtual = string.Equals(course?.Modality, "Virtual", StringComparison.OrdinalIgnoreCase);
            <article class="course-card">
                <div class="course-card-image">
                    @if (!string.IsNullOrEmpty(course?.ImageUrl))
                    {
                        <img src="@course.ImageUrl" alt="@course.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="course-card-image-placeholder">
                            <i class="bi bi-mortarboard"></i>
                            <span>@course?.Modality</span>
                        </div>
                    }
                    <div class="course-card-status">
                        <span class="badge badge-soft-primary">@course?.Modality</span>
                    </div>
                </div>

                <div class="course-card-body">
                    <h3 class="course-card-title">@course?.Title</h3>
                    @if (!string.IsNullOrEmpty(course?.Instructor))
                    {
                        <p class="course-card-instructor">
                            <i class="bi bi-person-badge me-1"></i>@course.Instructor
                        </p>
                    }

                    <div class="course-card-meta mb-2">
                        @if (course?.StartDate != null)
                        {
                            <div class="course-meta-row">
                                <i class="bi bi-calendar3"></i>
                                <span>@course.StartDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-EC"))</span>
                            </div>
                        }
                        <div class="course-meta-row">
                            <i class="bi bi-geo-alt"></i>
                            <span>@(isVirtual ? "Online" : course?.Venue ?? "-")</span>
                        </div>
                    </div>

                    @if (isVirtual)
                    {
                        <div class="course-access-info">
                            <i class="bi bi-camera-video"></i>
                            <span>Enlace:</span>
                            <a href="@MeetingLink(course!.Id)" target="_blank" class="course-access-link">@MeetingLink(course!.Id)</a>
                        </div>
                    }
                    else
                    {
                        <a href="https://www.google.com/maps/search/@Uri.EscapeDataString(course?.Venue ?? "")" target="_blank" class="course-access-link course-access-map">
                            <i class="bi bi-map me-1"></i>Ver en Google Maps
                        </a>
                    }

                    <div class="course-card-footer">
                        <div class="d-flex flex-column gap-1">
                            <span class="badge badge-soft-success w-fit">Activo</span>
                            <small class="text-muted" style="font-size:11px;">Comprado el @enrollment.EnrolledAt.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course?.Id" class="btn btn-outline-primary btn-sm" title="Detalles">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            @if (isVirtual)
                            {
                                <a href="@MeetingLink(course!.Id)" target="_blank" class="btn btn-primary btn-sm">
                                    <i class="bi bi-camera-video me-1"></i>Entrar
                                </a>
                            }
                        </div>
                    </div>

                    @if (course?.StartDate > DateTime.UtcNow)
                    {
                        <form asp-controller="MyCourses" asp-action="Cancel" method="post" class="mt-2" onsubmit="return confirm('¿Estás seguro de cancelar tu inscripción a este curso?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrollmentId" value="@enrollment.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="bi bi-x-circle me-1"></i>Cancelar inscripción
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}

<style>
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }
    .course-access-info {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 10px;
        background: var(--color-accent-soft);
        border-radius: var(--radius-md);
        font-size: 12px;
        margin-bottom: 4px;
        word-break: break-all;
    }
    .course-access-info i {
        font-size: 14px;
        color: var(--color-primary);
        flex-shrink: 0;
    }
    .course-access-info span {
        color: var(--color-muted);
        flex-shrink: 0;
    }
    .course-access-link {
        color: var(--color-primary);
        font-weight: 500;
        text-decoration: none;
    }
    .course-access-link:hover {
        text-decoration: underline;
    }
    .course-access-map {
        display: inline-flex;
        align-items: center;
        font-size: 12px;
        padding: 6px 10px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        margin-bottom: 4px;
        transition: var(--transition-base);
    }
    .course-access-map:hover {
        border-color: var(--color-primary-light);
        text-decoration: none;
    }
    .w-fit { width: fit-content; }
</style>
