@model BioGamaEcuador.Models.Record

@{
    ViewData["Title"] = "Detalle del registro";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">@(Model.Species?.CommonName ?? "Registro #" + Model.Id)</h1>
        <p class="page-header-subtitle">
            <span class="badge badge-soft-secondary">Registro #@Model.Id</span>
            <span class="badge @(Model.IsActive ? "badge-soft-success" : "badge-soft-danger") ms-1">
                @(Model.IsActive ? "Activo" : "Inactivo")
            </span>
        </p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") ||
            (User.IsInRole("Investigador") && Model.Researcher != null &&
             User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value == Model.Researcher.Email))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
        }
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Eliminar
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="app-card">
            <div class="app-card-header">
                <h5><i class="bi bi-info-circle me-2"></i>Información del espécimen</h5>
            </div>
            <div class="app-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Nombre científico</dt>
                    <dd class="col-sm-8"><em>@(Model.Species?.ScientificName ?? "—")</em></dd>

                    <dt class="col-sm-4 text-muted">Nombre común</dt>
                    <dd class="col-sm-8">@(Model.Species?.CommonName ?? "—")</dd>

                    <dt class="col-sm-4 text-muted">Fecha de descubrimiento</dt>
                    <dd class="col-sm-8">@Model.DiscoveryDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">Cantidad observada</dt>
                    <dd class="col-sm-8">@Model.ObservedQuantity</dd>

                    <dt class="col-sm-4 text-muted">Estado de conservación</dt>
                    <dd class="col-sm-8">@(Model.Species?.ConservationStatus?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted">Es endémica</dt>
                    <dd class="col-sm-8">@(Model.Species?.IsEndemic == true ? "Sí" : "No")</dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Observations))
        {
            <div class="app-card mt-4">
                <div class="app-card-header">
                    <h5><i class="bi bi-card-text me-2"></i>Observaciones</h5>
                </div>
                <div class="app-card-body">
                    <p class="mb-0">@Model.Observations</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Species?.Description))
        {
            <div class="app-card mt-4">
                <div class="app-card-header">
                    <h5><i class="bi bi-journal-text me-2"></i>Descripción de la especie</h5>
                </div>
                <div class="app-card-body">
                    <p class="mb-0">@Model.Species.Description</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="app-card">
            <div class="app-card-header">
                <h5><i class="bi bi-person me-2"></i>Investigador</h5>
            </div>
            <div class="app-card-body">
                @if (Model.Researcher != null)
                {
                    <p class="mb-1 fw-medium">@Model.Researcher.Name</p>
                    <p class="text-muted small mb-0">@Model.Researcher.Institution</p>
                }
                else
                {
                    <p class="text-muted mb-0">—</p>
                }
            </div>
        </div>

        <div class="app-card mt-4">
            <div class="app-card-header">
                <h5><i class="bi bi-geo-alt me-2"></i>Ubicación</h5>
            </div>
            <div class="app-card-body">
                @if (Model.Location != null)
                {
                    <p class="mb-1 fw-medium">@Model.Location.PlaceName</p>
                    <p class="text-muted small mb-0">
                        @Model.Location.Latitude&deg;, @Model.Location.Longitude&deg;
                        @if (Model.Location.Altitude > 0)
                        {
                            <br />@(Model.Location.Altitude) <text>msnm</text>
                        }
                    </p>
                    @if (Model.Location.NaturalReserve != null)
                    {
                        <p class="text-muted small mb-0 mt-2">
                            <i class="bi bi-tree me-1"></i>@Model.Location.NaturalReserve.Name
                        </p>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">—</p>
                }
            </div>
        </div>
    </div>
</div>
