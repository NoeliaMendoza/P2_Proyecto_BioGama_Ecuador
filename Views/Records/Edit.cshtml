@model BioGamaEcuador.Models.Record

@{
    ViewData["Title"] = "Editar Registro";
    var isCurrentInvestigator = ViewData["IsCurrentInvestigator"] as bool? ?? false;
    var currentResearcherName = ViewData["CurrentResearcherName"] as string ?? string.Empty;
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Editar Registro</h1>
        <p class="page-header-subtitle">Modifique los datos del avistamiento #@Model.Id</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="app-card form-card">
    <div class="app-card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsActive" />

            <div class="form-section">
                <h6 class="form-section-title"><i class="bi bi-info-circle me-2"></i>Información del avistamiento</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="SpeciesId" class="form-control" asp-items="ViewBag.SpeciesId">
                                <option value=""></option>
                            </select>
                            <label asp-for="SpeciesId">Especie</label>
                            <span asp-validation-for="SpeciesId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="LocationId" class="form-control" asp-items="ViewBag.LocationId">
                                <option value=""></option>
                            </select>
                            <label asp-for="LocationId">Ubicación</label>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        @if (isCurrentInvestigator)
                        {
                            <input type="hidden" asp-for="ResearcherId" />
                            <div class="form-floating">
                                <input class="form-control" value="@currentResearcherName" readonly />
                                <label>Investigador</label>
                            </div>
                        }
                        else
                        {
                            <div class="form-floating">
                                <select asp-for="ResearcherId" class="form-control" asp-items="ViewBag.ResearcherId">
                                    <option value=""></option>
                                </select>
                                <label asp-for="ResearcherId">Investigador</label>
                            </div>
                        }
                        <span asp-validation-for="ResearcherId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input asp-for="DiscoveryDate" type="date" class="form-control" />
                            <label asp-for="DiscoveryDate">Fecha del hallazgo</label>
                            <span asp-validation-for="DiscoveryDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input asp-for="ObservedQuantity" type="number" class="form-control" placeholder="Cantidad" />
                            <label asp-for="ObservedQuantity">Cantidad observada</label>
                            <span asp-validation-for="ObservedQuantity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Observations" class="form-control" placeholder="Observaciones" style="height:100px;"></textarea>
                            <label asp-for="Observations">Observaciones</label>
                            <span asp-validation-for="Observations" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
