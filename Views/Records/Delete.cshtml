@model BioGamaEcuador.Models.Record

@{
    ViewData["Title"] = "Eliminar registro";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Eliminar Registro</h1>
        <p class="page-header-subtitle">Está a punto de desactivar un registro de avistamiento</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="delete-card">
    <div class="app-card">
        <div class="app-card-body text-center py-5">
            <div class="delete-icon mx-auto">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h4 class="mt-3">¿Está seguro de que desea eliminar este registro?</h4>
            <p class="text-muted mb-4">Esta acción desactivará el registro. No se eliminará permanentemente.</p>

            <div class="text-start mx-auto" style="max-width:400px;">
                <table class="table table-borderless mb-0 app-table">
                    <tr>
                        <td class="text-muted ps-0">Especie</td>
                        <td class="pe-0 fw-medium">@Model.Species?.CommonName</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Ubicación</td>
                        <td class="pe-0 fw-medium">@Model.Location?.PlaceName</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Investigador</td>
                        <td class="pe-0 fw-medium">@Model.Researcher?.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Fecha de descubrimiento</td>
                        <td class="pe-0 fw-medium">@Model.DiscoveryDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Cantidad observada</td>
                        <td class="pe-0 fw-medium">@Model.ObservedQuantity</td>
                    </tr>
                </table>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
