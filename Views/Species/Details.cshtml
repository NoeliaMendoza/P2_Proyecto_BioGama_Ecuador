@model BioGamaEcuador.Models.Species
@{
    ViewData["Title"] = Model.CommonName;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="app-card detail-card overflow-hidden">
    <div class="row g-0">
        <div class="col-md-4 detail-image">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                var imageUrl = Model.ImageUrl.Trim();
                var imageSrc = imageUrl;
                var isAbsolute = Uri.TryCreate(imageUrl, UriKind.Absolute, out _);
                if (isAbsolute)
                {
                    imageSrc = imageUrl.Contains(" ") ? imageUrl.Replace(" ", "%20") : imageUrl;
                }
                else
                {
                    if (!imageUrl.StartsWith("~/") && !imageUrl.StartsWith("/"))
                    {
                        imageUrl = "~/images/" + imageUrl.TrimStart('/');
                    }
                    imageSrc = Url.Content(imageUrl);
                }
                <img src="@imageSrc" alt="@Model.CommonName" class="img-fluid" />
            }
            else
            {
                <div class="text-center text-muted">
                    <div class="stat-card-icon primary mx-auto mb-2"><i class="bi bi-image"></i></div>
                    <p class="small mb-0">Sin imagen disponible</p>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="app-card-body">
                <h3 class="fw-bold mb-1">@Model.CommonName</h3>
                <p class="text-muted fst-italic mb-3">@Model.ScientificName</p>

                @if (Model.ConservationStatus != null)
                {
                    var badgeClass = Model.ConservationStatus.Code switch
                    {
                        "CR" or "EN" => "badge-soft-danger",
                        "VU" => "badge-soft-warning",
                        "LC" => "badge-soft-success",
                        _ => "badge-soft-secondary"
                    };
                    <span class="badge @badgeClass me-1">@Model.ConservationStatus.Name (@Model.ConservationStatus.Code)</span>
                }
                @if (Model.IsEndemic)
                {
                    <span class="badge badge-soft-primary">Endémica</span>
                }

                <hr class="my-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4">Familia</dt>
                    <dd class="col-sm-8">@(Model.Family?.Name ?? "—")</dd>
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>
                    <dt class="col-sm-4">Registrado</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>

                <div class="form-actions mt-4 d-flex gap-2">
                    @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Eliminar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
