@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 400px;">
    <div class="mb-4 d-lg-none text-center">
        <div class="stat-card-icon primary mx-auto mb-3"><i class="bi bi-flower1"></i></div>
        <h2 class="fw-bold" style="color: var(--color-primary);">BioGama Ecuador</h2>
    </div>

    <div class="app-card auth-form-card">
        <div class="app-card-body p-4">
            <div class="auth-page-heading">
                <h2 class="auth-page-title">Iniciar sesión</h2>
                <p class="auth-page-subtitle">Accede con tu cuenta para administrar y registrar datos.</p>
            </div>

            <form id="account" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
                </div>

                <div class="d-grid mb-3">
                    <button id="login-submit" type="submit" class="btn btn-primary btn-lg">Iniciar sesión</button>
                </div>

                <div class="text-center small">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-muted">¿Olvidaste tu contraseña?</a>
                    <p class="mt-2 mb-0 text-muted">
                        ¿No tienes cuenta?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate</a>
                    </p>
                </div>
            </form>

            @if (Model.ExternalLogins?.Count > 0)
            {
                <div class="mt-4 pt-3" style="border-top:1px solid #dee2e6">
                    <p class="text-center text-muted small mb-3">O accede con</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit" class="btn btn-light border btn-sm py-2" name="provider" value="@provider.Name">
                                <i class="bi bi-google text-danger"></i> @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
