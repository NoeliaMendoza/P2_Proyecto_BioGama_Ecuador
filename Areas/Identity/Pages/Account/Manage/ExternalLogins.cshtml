@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Administrar inicios de sesión externos";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

@if (Model.CurrentLogins?.Count > 0)
{
    <h6 class="fw-semibold mb-3 text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">Inicios de sesión registrados</h6>
    <table class="table">
        <tbody>
            @foreach (var login in Model.CurrentLogins)
            {
                <tr>
                    <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                    <td>
                        @if (Model.ShowRemoveButton)
                        {
                            <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                <div>
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="btn btn-outline-danger" title="Eliminar este inicio de sesión de @login.ProviderDisplayName de tu cuenta">
                                        <i class="bi bi-box-arrow-right me-1"></i>Eliminar
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            @: &nbsp;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.OtherLogins?.Count > 0)
{
    <h6 class="fw-semibold mb-3 text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">Agregar otro proveedor externo</h6>
    <hr />
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
        <div id="socialLoginList">
            <p>
                @foreach (var provider in Model.OtherLogins)
                {
                    <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-primary me-2" name="provider" value="@provider.Name" title="Iniciar sesión con tu cuenta de @provider.DisplayName">
                        <i class="bi bi-plus-circle me-1"></i>@provider.DisplayName
                    </button>
                }
            </p>
        </div>
    </form>
}
