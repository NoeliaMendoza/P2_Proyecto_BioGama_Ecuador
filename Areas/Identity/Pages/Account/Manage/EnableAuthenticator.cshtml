@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar aplicacion de autenticacion";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}


<div>
    <p>Sigue estos pasos para configurar tu aplicacion de autenticacion:</p>
    <ol class="list">
        <li>
            <p>
                Descarga una aplicacion de autenticacion como Microsoft Authenticator para
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> y
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> o
                Google Authenticator para
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> y
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>Escanea el codigo QR o ingresa esta clave <kbd>@Model.SharedKey</kbd> en tu aplicacion de autenticacion. Los espacios y mayusculas no importan.</p>
            <div id="qrCode" style="width:200px;height:200px;margin:16px 0">
                <img src="data:image/png;base64,@Model.QrCodeBase64" alt="Codigo QR" style="width:200px;height:200px" />
            </div>
        </li>
        <li>
            <p>
                Una vez que hayas escaneado el codigo QR o ingresado la clave, la aplicacion te proporcionara
                un codigo unico. Ingresa el codigo en el campo de confirmacion a continuacion.
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Ingresa el codigo"/>
                            <label asp-for="Input.Code" class="control-label form-label">Codigo de verificacion</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Verificar</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
