@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Restablecer clave de autenticación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="alert alert-warning" role="alert">
    <p>
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>Si restableces tu clave de autenticación, tu aplicación de autenticación no funcionará hasta que la reconfigure.</strong>
    </p>
    <p class="mb-0">
        Este proceso deshabilita 2FA hasta que verifiques tu aplicación de autenticación.
        Si no completas la configuración de tu aplicación de autenticación, podrías perder el acceso a tu cuenta.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">
            <i class="bi bi-arrow-repeat me-1"></i>Restablecer clave de autenticación
        </button>
    </form>
</div>
