@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generar códigos de recuperación (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="alert alert-warning" role="alert">
    <p>
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>Guarda estos códigos en un lugar seguro.</strong>
    </p>
    <p>
        Si pierdes tu dispositivo y no tienes los códigos de recuperación, perderás el acceso a tu cuenta.
    </p>
    <p class="mb-0">
        Generar nuevos códigos de recuperación no cambia las claves utilizadas en las aplicaciones de autenticación. Si deseas cambiar la clave
        utilizada en una aplicación de autenticación, debes <a asp-page="./ResetAuthenticator">restablecer tus claves de autenticación.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">
            <i class="bi bi-arrow-repeat me-1"></i>Generar códigos de recuperación
        </button>
    </form>
</div>
