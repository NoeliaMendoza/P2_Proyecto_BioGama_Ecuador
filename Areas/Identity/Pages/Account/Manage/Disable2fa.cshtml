@page
@model Disable2faModel
@{
    ViewData["Title"] = "Deshabilitar autenticación de dos factores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="alert alert-warning" role="alert">
    <p>
        <strong><i class="bi bi-exclamation-triangle me-1"></i>Esta acción solo deshabilita 2FA.</strong>
    </p>
    <p class="mb-0">
        Deshabilitar 2FA no cambia las claves utilizadas en las aplicaciones de autenticación. Si deseas cambiar la clave
        utilizada en una aplicación de autenticación, debes <a asp-page="./ResetAuthenticator">restablecer tus claves de autenticación.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">
            <i class="bi bi-shield-x me-1"></i>Deshabilitar 2FA
        </button>
    </form>
</div>
