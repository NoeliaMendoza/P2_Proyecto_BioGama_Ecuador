@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 400px;">
    <div class="mb-4 d-lg-none text-center">
        <div class="stat-card-icon primary mx-auto mb-3"><i class="bi bi-flower1"></i></div>
        <h2 class="fw-bold" style="color: var(--color-primary);">BioGama Ecuador</h2>
    </div>
    <div class="app-card auth-form-card">
        <div class="app-card-body p-4">
            <div class="auth-page-heading">
                <h2 class="auth-page-title">Recuperar contraseña</h2>
                <p class="auth-page-subtitle">Ingrese su correo electrónico para recibir un enlace de recuperación.</p>
            </div>
            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Enviar enlace de recuperación</button>
                </div>
                <div class="text-center small">
                    <a asp-page="./Login" class="text-muted">Volver a inicio de sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
