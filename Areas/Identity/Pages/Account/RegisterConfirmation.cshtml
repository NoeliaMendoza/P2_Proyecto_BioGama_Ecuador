@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 500px; text-align: center;">
    <div class="app-card">
        <div class="app-card-body p-5">
            <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
            <h2 class="fw-bold mt-3 mb-2">Confirmación de registro</h2>
            <p class="text-muted">Se ha enviado un correo de confirmación a <strong>@Model.Email</strong>.</p>
            <p class="text-muted">Revise su bandeja de entrada y haga clic en el enlace para activar su cuenta.</p>
            <p class="text-muted small">Si no encuentra el correo, revise la carpeta de spam.</p>
            <a asp-page="./Login" class="btn btn-primary mt-3">Volver a inicio de sesión</a>
        </div>
    </div>
</div>
