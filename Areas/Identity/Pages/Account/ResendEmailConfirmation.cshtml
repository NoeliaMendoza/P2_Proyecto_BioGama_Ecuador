@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmación de correo";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 400px;">
    <div class="mb-4 d-lg-none text-center">
        <div class="stat-card-icon primary mx-auto mb-3"><i class="bi bi-flower1"></i></div>
        <h2 class="fw-bold" style="color: var(--color-primary);">BioGama Ecuador</h2>
    </div>
    <div class="app-card">
        <div class="app-card-body p-4">
            <h2 class="fw-bold mb-1" style="font-size: var(--font-size-xl);">Reenviar confirmación</h2>
            <p class="text-muted small mb-4">Ingrese su correo electrónico</p>
            <form method="post">
                <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Enviar correo de verificación</button>
                </div>
                <div class="text-center small">
                    <a asp-page="./Login" class="text-muted">Volver a inicio de sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
