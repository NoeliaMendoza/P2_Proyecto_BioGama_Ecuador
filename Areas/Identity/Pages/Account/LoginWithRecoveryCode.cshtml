@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de recuperación";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 400px;">
    <div class="mb-4 d-lg-none text-center">
        <div class="stat-card-icon primary mx-auto mb-3"><i class="bi bi-flower1"></i></div>
        <h2 class="fw-bold" style="color: var(--color-primary);">BioGama Ecuador</h2>
    </div>
    <div class="app-card">
        <div class="app-card-body p-4">
            <h2 class="fw-bold mb-1" style="font-size: var(--font-size-xl);">Código de recuperación</h2>
            <p class="text-muted small mb-4">Ha solicitado iniciar sesión con un código de recuperación. Esta sesión no será recordada hasta que proporcione un código de autenticación al iniciar sesión o deshabilite la verificación en dos pasos.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.RecoveryCode" class="form-label">Código de recuperación</label>
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="000000-000000" />
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Iniciar sesión</button>
                </div>
                <div class="text-center small">
                    <a asp-page="./Login" class="text-muted">Volver a inicio de sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
