@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 500px; text-align: center;">
    <div class="app-card">
        <div class="app-card-body p-5">
            <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
            <h2 class="fw-bold mt-3 mb-2">Acceso denegado</h2>
            <p class="text-muted">No tiene acceso a este recurso.</p>
            <a asp-page="./Login" class="btn btn-primary mt-3">Volver a inicio de sesión</a>
        </div>
    </div>
</div>
