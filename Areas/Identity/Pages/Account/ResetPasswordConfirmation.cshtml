@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="w-100" style="max-width: 500px; text-align: center;">
    <div class="app-card">
        <div class="app-card-body p-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            <h2 class="fw-bold mt-3 mb-2">Contraseña restablecida</h2>
            <p class="text-muted">Su contraseña ha sido restablecida exitosamente.</p>
            <a asp-page="./Login" class="btn btn-primary mt-3">Iniciar sesión</a>
        </div>
    </div>
</div>
